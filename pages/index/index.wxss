.home-v7-brand>view{flex:1;min-width:0;text-align:right}
.home-v7-brand text,.home-v7-brand label{display:block;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.home-v7-brand text{font-size:22rpx;font-weight:700}.home-v7-brand label{margin-top:2rpx;color:#8793a2;font-size:15rpx;letter-spacing:1rpx}
.home-v7-project{display:grid;padding:14rpx 24rpx;background:#fff;grid-template-columns:minmax(0,1.45fr) minmax(0,.8fr);gap:12rpx}
.home-v7-project>view{display:flex;min-width:0;height:74rpx;align-items:center;padding:0 18rpx;border:1rpx solid #d6e0eb;border-radius:10rpx;background:#fff}
.home-v7-project text{flex:1;min-width:0;overflow:hidden;font-size:24rpx;white-space:nowrap;text-overflow:ellipsis}.home-v7-project label{flex:0 0 auto;margin-left:8rpx;color:#5d6b7c;font-size:26rpx}
.home-v7-content{padding:16rpx 24rpx 28rpx}
.home-v7-model-card{overflow:hidden;border:1rpx solid #d6e0eb;border-radius:14rpx;background:#fff;box-shadow:0 8rpx 24rpx rgba(23,50,78,.06)}
.home-v7-toolbar{display:flex;height:76rpx;align-items:center;justify-content:space-between;padding:10rpx 14rpx 8rpx 16rpx}
.home-v7-tabs{display:flex;padding:5rpx;border-radius:10rpx;background:#f0f3f7}
.home-v7-tabs button{min-height:52rpx;padding:0 24rpx;color:#5d6b7c;font-size:21rpx;white-space:nowrap;background:transparent;border-radius:8rpx}
.home-v7-tabs button.active{color:#0b4aa2;font-weight:700;background:#fff;box-shadow:0 3rpx 10rpx rgba(23,50,78,.08)}
.home-v7-toolbar>text{max-width:180rpx;overflow:hidden;color:#8793a2;font-size:18rpx;white-space:nowrap;text-overflow:ellipsis}
.home-v7-model{height:600rpx;overflow:hidden;background:linear-gradient(180deg,#fff,#f2f6fa)}
.home-v7-model construction-twin-3d{display:block;width:100%;height:600rpx}.home-v7-model .model-paused{height:600rpx}
.home-v7-tip{display:flex;height:56rpx;align-items:center;justify-content:center;border-top:1rpx solid #e8eef5;color:#8793a2;font-size:19rpx;letter-spacing:.4rpx}
.home-v7-info{margin-top:16rpx;padding:22rpx 24rpx;color:#fff;border-radius:14rpx;background:linear-gradient(135deg,#0b4aa2,#1467c9);box-shadow:0 12rpx 28rpx rgba(11,74,162,.2)}
.home-v7-info-press{transform:scale(.99);opacity:.9}
.home-v7-info-head{display:flex;align-items:center;justify-content:space-between;gap:14rpx}
.home-v7-info-head>text{flex:1;min-width:0;overflow:hidden;font-size:28rpx;font-weight:700;white-space:nowrap;text-overflow:ellipsis}.home-v7-info-head>label{flex:0 0 auto;color:rgba(255,255,255,.8);font-size:18rpx}
.home-v7-overview{display:grid;margin-top:18rpx;grid-template-columns:repeat(3,minmax(0,1fr))}
.home-v7-overview>view{min-width:0;text-align:center;border-right:1rpx solid rgba(255,255,255,.2)}.home-v7-overview>view:last-child{border-right:0}
.home-v7-overview label,.home-v7-overview text{display:block}.home-v7-overview>view>label{color:rgba(255,255,255,.72);font-size:19rpx}.home-v7-overview text{margin-top:4rpx;font-size:34rpx;font-weight:700}.home-v7-overview .warning{color:#ffbf4a}.home-v7-overview .warning .unit{display:inline;margin-left:3rpx;color:inherit;font-size:18rpx}
.home-v7-info.selected{display:flex;min-height:142rpx;align-items:center}.home-v7-selected-copy{flex:1;min-width:0}.home-v7-info.selected>button{flex:0 0 176rpx;min-height:66rpx;margin-left:22rpx;padding:0 14rpx;color:#0b4aa2;font-size:20rpx;white-space:nowrap;background:#fff;border-radius:8rpx}
.home-v7-info-head .status{padding:4rpx 10rpx;color:#fff;font-size:17rpx;border:1rpx solid rgba(255,255,255,.42);border-radius:999rpx}.home-v7-info-head .status.complete{color:#d8ffec;background:rgba(22,132,91,.35)}.home-v7-info-head .status.working{color:#fff2c9;background:rgba(215,139,0,.35)}
.home-v7-progress-meta{display:flex;align-items:center;justify-content:space-between;margin-top:16rpx;color:rgba(255,255,255,.82);font-size:19rpx}.home-v7-progress{height:8rpx;margin-top:8rpx;overflow:hidden;border-radius:999rpx;background:rgba(255,255,255,.24)}.home-v7-progress>view{height:100%;border-radius:999rpx;background:#fff}
.home-v7-stage-card{margin-top:16rpx;padding:20rpx 0 16rpx;overflow:hidden;border:1rpx solid #d6e0eb;border-radius:14rpx;background:#fff;box-shadow:0 8rpx 24rpx rgba(23,50,78,.05)}
.home-v7-stage-head{display:flex;align-items:center;justify-content:space-between;padding:0 22rpx 16rpx}.home-v7-stage-head text{font-size:25rpx;font-weight:800}.home-v7-stage-head label{color:#8793a2;font-size:18rpx}
.home-v7-stage-scroll{width:100%;white-space:nowrap}.home-v7-stage-track{display:inline-flex;min-width:100%;padding:0 14rpx 4rpx}
.home-v7-stage-item{position:relative;display:flex;width:106rpx;flex:0 0 106rpx;flex-direction:column;align-items:center;padding:8rpx 2rpx 10rpx;border-radius:10rpx}.home-v7-stage-item:after{position:absolute;z-index:0;top:37rpx;left:80rpx;width:52rpx;height:3rpx;background:#dce5ef;content:''}.home-v7-stage-item:last-child:after{display:none}.home-v7-stage-press{background:#f0f6ff}
.home-v7-stage-icon{position:relative;z-index:1;display:flex;width:58rpx;height:58rpx;align-items:center;justify-content:center;border:2rpx solid #bdcad8;border-radius:50%;background:#fff}.home-v7-stage-icon image{width:36rpx;height:36rpx;opacity:.65}.home-v7-stage-item>text,.home-v7-stage-item>label{display:block;overflow:hidden;width:100%;text-align:center;white-space:nowrap;text-overflow:ellipsis}.home-v7-stage-item>text{margin-top:8rpx;color:#5d6b7c;font-size:18rpx}.home-v7-stage-item>label{margin-top:2rpx;color:#8793a2;font-size:16rpx}.home-v7-stage-item.current{background:#eef5ff}.home-v7-stage-item.current .home-v7-stage-icon{border-color:#0b4aa2;box-shadow:0 0 0 5rpx #e5f0ff}.home-v7-stage-item.current .home-v7-stage-icon image{opacity:1}.home-v7-stage-item.current>text,.home-v7-stage-item.current>label{color:#0b4aa2;font-weight:700}.home-v7-stage-item.completed .home-v7-stage-icon{border-color:#16845b}.home-v7-stage-item.completed:after{background:#7dc5a7}
@media (max-width:360px){.home-v7-brand{padding-right:20rpx;padding-left:20rpx}.home-v7-brand>image{flex-basis:238rpx;width:238rpx}.home-v7-brand label{display:none}.home-v7-project{padding-right:18rpx;padding-left:18rpx}.home-v7-content{padding-right:18rpx;padding-left:18rpx}.home-v7-model{height:560rpx}.home-v7-model construction-twin-3d,.home-v7-model .model-paused{height:560rpx}.home-v7-tabs button{padding-right:18rpx;padding-left:18rpx}.home-v7-info.selected>button{flex-basis:158rpx;margin-left:14rpx;padding-right:9rpx;padding-left:9rpx}}
