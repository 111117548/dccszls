page{background:var(--bg);color:var(--text)}.daily-page{min-height:100vh;padding-bottom:56rpx;background:var(--bg)}
.daily-overview-card{margin:22rpx 24rpx 18rpx;padding:26rpx 24rpx;border:1rpx solid var(--line-soft);border-radius:24rpx;background:#fff;box-shadow:var(--shadow-sm)}.daily-overview-head{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx}.daily-overview-head>view{min-width:0}.daily-overview-kicker,.daily-overview-title{display:block}.daily-overview-kicker{color:var(--brand);font-size:20rpx;font-weight:600}.daily-overview-title{margin-top:5rpx;font-size:36rpx;font-weight:700;line-height:1.25}.date-chip{flex:none;padding:9rpx 16rpx;color:var(--brand);font-size:21rpx;border:1rpx solid #b7d0ef;border-radius:999rpx;background:var(--brand-soft)}
.inherit-tip{margin:0 24rpx 18rpx;padding:18rpx 22rpx;color:#7a5700;font-size:21rpx;line-height:1.55;border:1rpx solid #ead397;border-radius:14rpx;background:#fff9e8}
.daily-progress-summary{display:flex;align-items:center;justify-content:space-between;gap:18rpx;margin-top:22rpx;padding:20rpx 22rpx;border-radius:16rpx;background:var(--brand-soft)}.daily-progress-summary>view{min-width:0}.daily-progress-summary text,.daily-progress-summary label{display:block}.daily-progress-summary text{color:var(--brand);font-size:24rpx;font-weight:700}.daily-progress-summary label{margin-top:5rpx;color:var(--text-2);font-size:20rpx;line-height:1.45}.daily-progress-summary button{flex:none;min-width:164rpx;height:62rpx;margin:0;padding:0 16rpx;color:var(--brand);font-size:20rpx;line-height:60rpx;border:1rpx solid #9fbee4;border-radius:14rpx;background:#fff}.daily-progress-summary button::after{border:0}
.edit-card{margin:0 24rpx 20rpx;padding:26rpx 24rpx;border:1rpx solid var(--line-soft);border-radius:24rpx;background:#fff;box-shadow:var(--shadow-sm)}.card-heading{margin-bottom:14rpx}.card-heading text,.card-heading label{display:block}.card-heading text{font-size:30rpx;font-weight:700}.card-heading label{margin-top:4rpx;color:var(--text-3);font-size:20rpx}
.item-row{display:flex;align-items:flex-start;min-height:88rpx;padding:18rpx 0;border-bottom:1rpx solid var(--line-soft)}.item-index{display:flex;flex:none;align-items:center;justify-content:center;width:42rpx;height:42rpx;margin:2rpx 14rpx 0 0;color:var(--brand);font-size:21rpx;font-weight:700;border-radius:50%;background:var(--brand-soft)}.item-row textarea{flex:1;min-width:0;min-height:48rpx;color:var(--text);font-size:25rpx;line-height:1.55}.remove-item{flex:none;margin:7rpx 0 0 12rpx;color:var(--danger);font-size:20rpx}.add-button{width:100%;min-height:72rpx;margin-top:18rpx;color:var(--brand);font-size:23rpx;border:1rpx dashed #9fbee4;border-radius:14rpx;background:#f7fbff}.add-button::after{border:0}
.daily-action-card{margin:0 24rpx 20rpx;padding:26rpx 24rpx;border:1rpx solid var(--line-soft);border-radius:24rpx;background:#fff;box-shadow:var(--shadow-sm)}.daily-actions{display:grid;grid-template-columns:1fr 1.5fr;gap:16rpx;margin-top:20rpx}.daily-actions button{width:100%;min-height:86rpx;margin:0;font-size:26rpx;font-weight:600;border-radius:16rpx}.secondary-action{color:var(--brand);border:1rpx solid var(--brand);background:#fff}.primary-action{color:#fff;background:#1677ff}.save-state,.permission-state{display:block;margin-top:14rpx;color:var(--text-3);font-size:20rpx;text-align:center}.permission-state{color:var(--danger)}.safe-bottom{height:env(safe-area-inset-bottom)}
@media (max-width:360px){.daily-overview-card,.edit-card,.daily-action-card{margin-right:18rpx;margin-left:18rpx}.daily-progress-summary{align-items:flex-start;flex-direction:column}.daily-progress-summary button{width:100%}}
