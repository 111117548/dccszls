.report-grid{display:flex;flex-direction:column;gap:24rpx;margin-top:24rpx}.daily-card,.outline{padding:28rpx;background:var(--color-neutral-850);border:2rpx solid var(--border-default);border-radius:var(--radius-sm)}.card-title{font-size:34rpx;line-height:1.4}.card-sub{color:var(--text-secondary);font-size:24rpx;line-height:1.6}.daily-stats{display:flex;flex-wrap:wrap}.daily-stats view{width:50%;min-height:112rpx;padding:20rpx;box-sizing:border-box}.daily-stats text{font-size:40rpx}.daily-stats label{font-size:21rpx}.generate{min-height:96rpx;height:auto;line-height:1.4;font-size:27rpx}
.outline>view:not(:first-child){min-height:76rpx}.outline>view text{font-size:21rpx}.outline>view label{font-size:23rpx}.section-title{min-height:88rpx}.section-title text{font-size:30rpx}.section-title label{display:none}
.summary-table,.report-list{background:var(--color-neutral-850);border:2rpx solid var(--border-default)}.table-head,.table-row{display:flex;align-items:center;min-height:88rpx;gap:12rpx;padding:0 18rpx}.table-head>text:nth-child(1),.table-row>text:nth-child(1){width:31%}.table-head>text:nth-child(2),.table-row>text:nth-child(2){flex:1}.table-head>text:nth-child(5),.table-row>text:nth-child(5){width:22%;text-align:right}.table-head>text:nth-child(3),.table-head>text:nth-child(4),.table-row>text:nth-child(3),.table-row>text:nth-child(4){display:none}.table-row{font-size:23rpx}
.report-file{display:flex;align-items:center;width:100%;min-height:104rpx;margin:0;padding:18rpx;color:var(--text-primary);background:transparent;border:0;border-bottom:1rpx solid var(--border-subtle);border-radius:0;text-align:left;line-height:1.4}.report-file::after{border:0}.report-file>view{flex:1;min-width:0;margin-left:16rpx}.report-file>view>text{display:block;color:var(--text-primary);font-size:25rpx}.report-file>view>label{display:block;color:var(--text-secondary);font-size:21rpx}.report-file>text:last-child{color:var(--color-primary);font-size:23rpx}

/* V5.2 reference visual alignment */
page{background:#020d18}.report-page{background:radial-gradient(circle at 50% 4%,rgba(45,149,255,.12),transparent 34%),linear-gradient(180deg,#010812,#020d18)}
.daily-card,.outline,.summary-table,.report-list{background:rgba(7,24,39,.92);border-color:var(--line)}.daily-card{border-left-color:var(--blue)}
.page-head text,.card-code,.outline-title,.outline>view text,.report-list>view>text:last-child{color:var(--blue)}
.section-title text{border-left-color:var(--blue)}.generate{color:#fff;background:linear-gradient(135deg,#1978dd,#1051af);border:1rpx solid var(--blue)}
.file-icon{color:#fff;background:#176bc7;border-color:var(--blue)}.table-head{background:#10263a}

/* V6 企业协同明亮主题 */
page{background:var(--bg);color:var(--text)}
.report-page{background:var(--bg);color:var(--text)}
.page-head{border-bottom-color:var(--line)}
.page-head text,.card-code,.outline-title,.outline>view text,.report-list>view>text:last-child{color:var(--brand)}
.page-head label,.card-title{color:var(--text)}
.page-head .date,.card-sub{color:var(--text-2)}
.daily-card,.outline,.summary-table,.report-list{background:#fff;border-color:var(--line);box-shadow:var(--shadow-sm)}
.daily-card{border-left-color:var(--brand)}
.daily-stats{border-color:var(--line)}
.daily-stats view{border-right-color:var(--line)}
.daily-stats text{color:var(--text)}
.daily-stats label{color:var(--text-2)}
.generate{color:#fff;background:linear-gradient(135deg,var(--brand),var(--brand-2));border-color:var(--brand)}
.outline-title,.outline>view:not(:first-child){border-bottom-color:var(--line)}
.outline>view label{min-width:0;color:var(--text-2);overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.section-title text{color:var(--text);border-left-color:var(--brand)}
.table-head{color:var(--text-2);background:#eef3f8}
.table-row{color:var(--text);border-bottom-color:var(--line)}
.table-row>text{min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.report-file{color:var(--text);border-bottom-color:var(--line)}
.report-file>view>text{color:var(--text);overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.report-file>view>label{color:var(--text-2);overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.report-file>text:last-child{color:var(--brand);white-space:nowrap}
.file-icon{color:#fff;background:var(--brand);border-color:var(--brand)}
.empty{color:var(--text-3)}

/* 报告按钮统一文字基线，文件条目继续使用左对齐信息布局。 */
.generate{
  display:flex;
  align-items:center;
  justify-content:center;
  line-height:1.2;
  text-align:center;
}
.report-file{
  justify-content:flex-start;
  white-space:normal;
}
