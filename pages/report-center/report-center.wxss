page { background:#040c15; color:#d5eaf2; }
.report-page { padding:22rpx; min-height:100vh; box-sizing:border-box; }
.page-head { display:flex; align-items:center; justify-content:space-between; min-height:110rpx; border-bottom:1rpx solid rgba(66,181,215,.3); }
.page-head text { display:block; color:#4ad5f3; font:19rpx monospace; letter-spacing:2rpx; }
.page-head label { display:block; color:#c6dce5; font-size:21rpx; margin-top:7rpx; }
.page-head .date { color:#668b9c; font-size:18rpx; }
.report-grid { display:flex;flex-wrap:wrap;  gap:16rpx; margin-top:18rpx; }
.daily-card,.outline { padding:26rpx; background:linear-gradient(135deg,rgba(11,47,67,.96),rgba(6,22,34,.92)); border:1rpx solid rgba(62,181,215,.32); }
.card-code { color:#44d3f1; font:17rpx monospace; letter-spacing:2rpx; }
.card-title { display:block; color:#fff; font-size:29rpx; font-weight:700; margin-top:13rpx; }
.card-sub { display:block; color:#7094a3; font-size:18rpx; margin-top:8rpx; }
.daily-stats { display:flex;flex-wrap:wrap;  margin-top:24rpx; border:1rpx solid rgba(63,177,210,.2); }
.daily-stats view { padding:18rpx; text-align:center; border-right:1rpx solid rgba(63,177,210,.15); }
.daily-stats text { display:block; color:#e8faff; font:700 31rpx monospace; }
.daily-stats text.warn { color:#efbc4e; }
.daily-stats text.danger { color:#ff5a70; }
.daily-stats label { display:block; color:#628596; font-size:16rpx; margin-top:6rpx; }
.generate { margin-top:22rpx; height:70rpx; line-height:70rpx; border-radius:0; color:#03141f; background:#43d3f1; font-size:20rpx; }
.outline { padding:18rpx; }
.outline-title { height:45rpx; color:#45d0ee; border-bottom:1rpx solid rgba(63,177,210,.22); font:17rpx monospace; }
.outline>view:not(:first-child) { display:flex; align-items:center; min-height:53rpx; border-bottom:1rpx solid rgba(63,177,210,.12); }
.outline>view text { width:32rpx; color:#3ec6e5; font:16rpx monospace; }
.outline>view label { color:#91aeba; font-size:17rpx; }
.section-title { display:flex; justify-content:space-between; margin:28rpx 0 12rpx; }
.section-title text { color:#e2f2f7; font-size:23rpx; font-weight:600; border-left:3rpx solid #42d1ef; padding-left:11rpx; }
.section-title label { color:#4f7485; font:16rpx monospace; letter-spacing:2rpx; }
.summary-table,.report-list { background:rgba(6,23,35,.82); border:1rpx solid rgba(65,177,210,.28); }
.table-head,.table-row { display:flex;flex-wrap:wrap;  align-items:center; min-height:64rpx; padding:0 18rpx; column-gap:12rpx; border-bottom:1rpx solid rgba(65,177,210,.14); box-sizing:border-box; }
.table-head { color:#587e90; background:rgba(19,60,78,.35); font-size:16rpx; }
.table-row { color:#c1d8e1; font-size:18rpx; }
.mono { color:#45cee9; font:16rpx monospace; }
.status { color:#eeb84c; }
.status-rectifying { color:#47d2ee; }
.status-closed { color:#35d39a; }
.report-list>view { display:flex; align-items:center; min-height:78rpx; padding:0 18rpx; border-bottom:1rpx solid rgba(65,177,210,.14); }
.file-icon { padding:6rpx 9rpx; color:#45d4f2; border:1rpx solid #2c91ac; font:15rpx monospace; }
.report-list view view { flex:1; margin-left:14rpx; }
.report-list view view text { display:block; color:#d7e9ef; font-size:19rpx; }
.report-list view view label { display:block; color:#5b8192; font-size:16rpx; margin-top:5rpx; }
.report-list>view>text:last-child { color:#42cce9; font-size:17rpx; }
.empty { padding:45rpx!important; justify-content:center!important; color:#557d8e; }
/* 方案C */
page{background:#14191c;color:#f4f7f8}.report-page{background:linear-gradient(180deg,#1b2225,#111618);padding:24rpx}.page-head{min-height:122rpx;border-bottom:2rpx solid #68747a}.page-head text{color:#ffc229;font-size:20rpx;font-weight:700}.page-head label{color:#fff;font-size:22rpx}.page-head .date{color:#c2cace;font-size:20rpx}.daily-card,.outline{background:#252d30;border:1rpx solid #69757a}.daily-card{border-left:7rpx solid #ffc229}.card-code{color:#ffc229;font-size:18rpx;font-weight:700}.card-title{font-size:31rpx}.card-sub{color:#c0c8cb;font-size:20rpx}.daily-stats{border-color:#5f6a6f}.daily-stats view{padding:22rpx;border-right-color:#566166}.daily-stats text{color:#fff;font-size:35rpx}.daily-stats text.warn{color:#ffc229}.daily-stats text.danger{color:#ff6258}.daily-stats label{color:#b5bfc3;font-size:18rpx}.generate{height:78rpx;line-height:78rpx;color:#111619;background:#ffc229;font-size:22rpx;font-weight:700}.outline-title{color:#ffc229;border-bottom-color:#616d72}.outline>view:not(:first-child){min-height:60rpx;border-bottom-color:#4e585d}.outline>view text{color:#ffc229;font-size:18rpx}.outline>view label{color:#d7dcde;font-size:19rpx}.section-title text{color:#fff;font-size:25rpx;border-left:5rpx solid #ffc229}.section-title label{color:#9fa9ad}.summary-table,.report-list{background:#20272a;border:1rpx solid #657177}.table-head{color:#d4dbdd;background:#30383b;font-size:18rpx}.table-row{min-height:74rpx;color:#f0f3f4;border-bottom-color:#4d575c;font-size:20rpx}.mono{color:#20c7c5}.status{color:#ffc229}.status-rectifying{color:#20c7c5}.status-closed{color:#68e378}.report-list>view{min-height:88rpx;border-bottom-color:#4e585d}.file-icon{color:#111619;background:#ffc229;border-color:#ffc229}.report-list view view text{color:#fff;font-size:21rpx}.report-list view view label{color:#aeb8bc;font-size:18rpx}.report-list>view>text:last-child{color:#ffc229;font-weight:700}.empty{color:#aeb8bc}
