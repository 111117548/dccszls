<view class="daily-page">
  <view class="shared-brand-bar"><image src="/images/brand/zijin-longking-horizontal.png" mode="aspectFit" aria-label="紫金龙净"></image><view><text>工程质量数字化平台</text><label>ENGINEERING QUALITY</label></view></view>

  <view class="feature-guide-entry" bindtap="openFeatureGuide" hover-class="ux-press" role="button">
    <view class="feature-guide-icon">?</view><view class="feature-guide-copy"><text>施工日报使用说明</text><label>进度关联、内容修改、暂存与次日继承</label></view><text class="feature-guide-arrow">›</text>
  </view>

  <view class="daily-overview-card">
    <view class="daily-overview-head">
      <view>
        <text class="daily-overview-kicker">日报概况</text>
        <text class="daily-overview-title">施工日报</text>
      </view>
      <text class="date-chip">{{dateLabel}}</text>
    </view>
    <view class="daily-progress-summary">
      <view>
        <text>已关联安装进度</text>
        <label>{{progressSummary}}</label>
      </view>
      <button wx:if="{{canEdit}}" bindtap="mergeLatestProgress">同步最新进度</button>
    </view>
  </view>

  <view wx:if="{{inherited}}" class="inherit-tip">已合并上一份“明日计划”和当前未完工部件，可直接增减修改。</view>

  <view class="edit-card">
    <view class="card-heading"><view><text>今日施工</text><label>当前阶段及前序未完成部件已自动带入</label></view></view>
    <block wx:for="{{todayItems}}" wx:key="index">
      <view class="item-row">
        <text class="item-index">{{index + 1}}</text>
        <textarea auto-height maxlength="200" value="{{item}}" placeholder="输入施工事项" data-section="today" data-index="{{index}}" bindinput="onItemInput" disabled="{{!canEdit}}"></textarea>
        <text wx:if="{{canEdit}}" class="remove-item" data-section="today" data-index="{{index}}" bindtap="removeItem">删除</text>
      </view>
    </block>
    <button wx:if="{{canEdit}}" class="add-button" data-section="today" bindtap="addItem">＋ 添加今日施工事项</button>
  </view>

  <view class="edit-card">
    <view class="card-heading"><view><text>明日计划</text><label>可在预生成内容上增减，下一份日报继续继承</label></view></view>
    <block wx:for="{{tomorrowItems}}" wx:key="index">
      <view class="item-row">
        <text class="item-index">{{index + 1}}</text>
        <textarea auto-height maxlength="200" value="{{item}}" placeholder="输入计划事项" data-section="tomorrow" data-index="{{index}}" bindinput="onItemInput" disabled="{{!canEdit}}"></textarea>
        <text wx:if="{{canEdit}}" class="remove-item" data-section="tomorrow" data-index="{{index}}" bindtap="removeItem">删除</text>
      </view>
    </block>
    <button wx:if="{{canEdit}}" class="add-button" data-section="tomorrow" bindtap="addItem">＋ 添加明日计划事项</button>
  </view>

  <view class="daily-action-card">
    <view class="card-heading"><view><text>日报操作</text><label>确认内容后暂存，也可复制到群聊或其他平台</label></view></view>
    <view class="daily-actions">
      <button class="secondary-action" bindtap="copyReport">复制文本</button>
      <button class="primary-action" loading="{{saving}}" disabled="{{saving || !canEdit}}" bindtap="saveDraft">暂存日报</button>
    </view>
    <text class="save-state">{{savedAtLabel ? '最近暂存 ' + savedAtLabel : '尚未暂存'}}{{dirty ? ' · 有未保存修改' : ''}}</text>
    <text wx:if="{{!canEdit}}" class="permission-state">当前项目仅可查看</text>
  </view>
  <view class="safe-bottom"></view>
</view>
