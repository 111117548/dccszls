<view class="account-page" wx:if="{{!authUrl}}">
  <view class="account-hero">
    <view class="feishu-logo">飞</view>
    <text>飞书账号认证</text>
    <label>项目权限以飞书多维表格“项目负责人”为准</label>
  </view>

  <view class="state-card" wx:if="{{loading}}">正在读取账号状态…</view>
  <view class="state-card error" wx:elif="{{error}}">
    <text>{{errorCode === 'FUNCTION_NOT_FOUND' ? '身份服务尚未部署' : '身份服务暂不可用'}}</text>
    <label>{{error}}</label>
    <button bindtap="refreshStatus">重新检测</button>
  </view>

  <view class="profile-card" wx:elif="{{profile.bound}}">
    <image wx:if="{{profile.avatarUrl}}" src="{{profile.avatarUrl}}" mode="aspectFill"></image>
    <view class="avatar-fallback" wx:else>飞</view>
    <view class="profile-copy">
      <text>{{profile.name}}</text>
      <label>{{profile.roleName}}</label>
      <label>{{profile.authModeName || '已绑定飞书身份'}}{{profile.phoneSuffix ? ' · 尾号 ' + profile.phoneSuffix : ''}}</label>
    </view>
    <text class="bound-mark">✓</text>
  </view>

  <view class="rule-card">
    <text>权限规则</text>
    <label>· 所有已认证项目经理可以查看全部项目</label>
    <label>· 只能编辑飞书中由自己负责的项目</label>
    <label>· 平台管理员可以编辑全部项目</label>
    <label>· 整改人员仍通过单条整改分享链接协作</label>
  </view>

  <button wx:if="{{!profile.bound}}" class="primary" open-type="getPhoneNumber" bindgetphonenumber="bindByPhone" loading="{{binding}}" disabled="{{!serviceAvailable || binding}}">微信手机号一键绑定</button>
  <button wx:if="{{profile.bound}}" class="secondary" open-type="getPhoneNumber" bindgetphonenumber="bindByPhone" loading="{{binding}}" disabled="{{binding}}">重新识别飞书身份</button>
  <view class="phone-bind-error" wx:if="{{phoneError}}">{{phoneError}}</view>
  <button wx:if="{{oauthConfigured}}" class="oauth-fallback" bindtap="startBinding" loading="{{binding}}" disabled="{{!serviceAvailable || binding}}">手机号无法匹配？使用飞书授权</button>
  <button wx:if="{{profile.bound}}" class="danger" bindtap="unbind">解除绑定</button>
  <view class="binding-tip" wx:if="{{!profile.bound}}">微信手机号只用于匹配公司飞书通讯录，不会在小程序页面展示。</view>
  <view class="config-tip" wx:if="{{!loading && !error && serviceAvailable && !oauthConfigured}}">备用飞书 OAuth 尚未配置，不影响手机号一键绑定。</view>
</view>

<view class="auth-shell" wx:if="{{authUrl}}">
  <view class="external-auth-card">
    <view class="external-auth-icon">飞</view>
    <text class="external-auth-title">绑定你自己的飞书账号</text>
    <label class="external-auth-subtitle">微信无法直接打开飞书授权页，请按以下步骤完成认证</label>

    <view class="external-auth-steps">
      <view><text>1</text><label>复制本次专属授权链接</label></view>
      <view><text>2</text><label>切换到手机浏览器或飞书，粘贴并打开链接</label></view>
      <view><text>3</text><label>使用你本人的飞书账号授权，然后返回小程序</label></view>
    </view>

    <view class="auth-security-tip">链接仅绑定当前微信账号，10 分钟内有效，请勿转发给其他人。</view>
    <button class="primary external-primary" bindtap="copyAuthUrl">复制授权链接</button>
    <button class="secondary external-secondary" bindtap="checkBinding" loading="{{checking}}" disabled="{{checking}}">我已授权，检测绑定结果</button>
    <button class="external-cancel" bindtap="closeAuth">取消绑定</button>
  </view>
</view>
