.account-page { min-height: 100vh; padding: 40rpx 28rpx 80rpx; box-sizing: border-box; background: #f4f7fb; color: #172b4d; }
.account-hero { padding: 42rpx 24rpx 30rpx; text-align: center; }
.account-hero text,.account-hero label { display: block; }
.account-hero text { margin-top: 18rpx; font-size: 38rpx; font-weight: 800; }
.account-hero label { margin-top: 10rpx; color: #6b778c; font-size: 24rpx; }
.feishu-logo { width: 88rpx; height: 88rpx; margin: 0 auto; color: #fff; font-size: 42rpx; font-weight: 800; line-height: 88rpx; background: #1456c0; border-radius: 24rpx; }
.state-card,.profile-card,.rule-card,.config-tip { margin-bottom: 24rpx; padding: 28rpx; background: #fff; border: 1rpx solid #d9e2ec; border-radius: 14rpx; }
.state-card { text-align: center; color: #6b778c; }
.state-card.error,.config-tip { color: #b42318; background: #fff6f5; border-color: #f2b8b5; }
.state-card.error text,.state-card.error label{display:block}
.state-card.error text{font-size:28rpx;font-weight:800}
.state-card.error label{margin-top:12rpx;font-size:22rpx;line-height:1.6;word-break:break-word}
.state-card.error button{width:100%;min-height:68rpx;margin-top:20rpx;padding:10rpx 18rpx;color:#b42318;background:#fff;border:1rpx solid #e5a49f}
.profile-card { display: flex; align-items: center; }
.profile-card image,.avatar-fallback { flex: 0 0 88rpx; width: 88rpx; height: 88rpx; margin-right: 22rpx; border-radius: 50%; }
.avatar-fallback { color: #fff; font-size: 36rpx; line-height: 88rpx; text-align: center; background: #1456c0; }
.profile-copy { flex: 1; min-width: 0; }
.profile-copy text,.profile-copy label { display: block; }
.profile-copy text { font-size: 32rpx; font-weight: 800; }
.profile-copy label { margin-top: 6rpx; color: #6b778c; font-size: 22rpx; }
.bound-mark { color: #087f5b; font-size: 40rpx; }
.rule-card text,.rule-card label { display: block; }
.rule-card text { margin-bottom: 16rpx; font-size: 28rpx; font-weight: 800; }
.rule-card label { margin-top: 10rpx; color: #5d6b7a; font-size: 24rpx; line-height: 1.6; }
button { margin-top: 20rpx; }
button.primary { color: #fff; background: #1456c0; }
button.secondary { color: #1456c0; background: #fff; border: 1rpx solid #1456c0; }
button.danger { color: #b42318; background: #fff; border: 1rpx solid #efb0ab; }
.oauth-fallback{color:#5d6b7a;background:transparent;border:0;font-size:22rpx}
.phone-bind-error{margin:18rpx 0 0;padding:18rpx 22rpx;color:#c62828;font-size:24rpx;line-height:1.55;background:#fff5f5;border:1rpx solid #f3b7b7;border-radius:12rpx}
.binding-tip{margin-top:18rpx;color:#7b8794;font-size:21rpx;line-height:1.55;text-align:center}
.config-tip { margin-top: 24rpx; font-size: 23rpx; line-height: 1.6; }
.auth-shell { min-height: 100vh; background: #fff; }

/* V7 account page text and action alignment */
.account-page>button{width:100%;padding-top:14rpx;padding-bottom:14rpx;line-height:1.3}
.profile-copy text{overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.profile-copy label{line-height:1.45;word-break:break-word}
.bound-mark{flex:0 0 auto;margin-left:12rpx}
@media (max-width:360px){
  .account-page{padding-left:22rpx;padding-right:22rpx}
  .account-hero{padding-left:12rpx;padding-right:12rpx}
  .state-card,.profile-card,.rule-card,.config-tip{padding:22rpx}
}

/* OAuth 在系统浏览器/飞书中完成，避开小程序 web-view 第三方业务域名限制。 */
.auth-shell{
  box-sizing:border-box;
  min-height:100vh;
  padding:calc(76rpx + env(safe-area-inset-top)) 28rpx 80rpx;
  background:#f4f7fb;
}
.external-auth-card{
  padding:48rpx 30rpx 34rpx;
  background:#fff;
  border:1rpx solid #d9e2ec;
  border-radius:20rpx;
  box-shadow:0 12rpx 36rpx rgba(23,50,78,.08);
  text-align:center;
}
.external-auth-icon{
  width:92rpx;
  height:92rpx;
  margin:0 auto;
  color:#fff;
  font-size:42rpx;
  font-weight:800;
  line-height:92rpx;
  background:#1456c0;
  border-radius:24rpx;
}
.external-auth-title,.external-auth-subtitle{display:block}
.external-auth-title{margin-top:24rpx;color:#172b4d;font-size:34rpx;font-weight:800;line-height:1.35}
.external-auth-subtitle{margin-top:10rpx;color:#6b778c;font-size:22rpx;line-height:1.55}
.external-auth-steps{margin-top:34rpx;padding:8rpx 22rpx;background:#f7faff;border-radius:14rpx;text-align:left}
.external-auth-steps view{display:flex;align-items:flex-start;gap:18rpx;padding:20rpx 0;border-bottom:1rpx solid #e7edf5}
.external-auth-steps view:last-child{border-bottom:0}
.external-auth-steps text{flex:0 0 42rpx;width:42rpx;height:42rpx;color:#fff;font-size:22rpx;line-height:42rpx;text-align:center;background:#1456c0;border-radius:50%}
.external-auth-steps label{flex:1;color:#334e68;font-size:24rpx;line-height:1.55}
.auth-security-tip{margin-top:24rpx;padding:18rpx;color:#8a5a00;font-size:21rpx;line-height:1.55;background:#fff8e6;border:1rpx solid #f3d38a;border-radius:10rpx;text-align:left}
.external-auth-card button{width:100%;min-height:82rpx;padding:12rpx 20rpx;line-height:1.35}
.external-primary{margin-top:30rpx}
.external-secondary{margin-top:18rpx}
.external-auth-card .external-cancel{margin-top:16rpx;color:#6b778c;background:transparent;border:0}

@media (max-width:360px){
  .auth-shell{padding-right:20rpx;padding-left:20rpx}
  .external-auth-card{padding-right:22rpx;padding-left:22rpx}
  .external-auth-title{font-size:31rpx}
}
