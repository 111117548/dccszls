.process-form-screen{padding-bottom:70rpx}.form-meta{margin:26rpx 24rpx;border:1rpx solid var(--line)}.form-meta>view{display:flex;min-height:78rpx;border-bottom:1rpx solid var(--line-soft)}.form-meta>view:last-child{border:0}.form-meta label{width:150rpx;padding:20rpx;color:var(--text-2);border-right:1rpx solid var(--line-soft)}.form-meta>view>text,.form-meta picker{flex:1;padding:20rpx}.form-meta picker text{color:var(--blue)}
.diagram{padding:30rpx}.diagram>text{display:block;color:var(--blue)}.diagram-line{display:flex;justify-content:space-around;margin:20rpx 0;border-bottom:3rpx solid #2d95ff}.diagram-line view{text-align:center}.diagram-line view text{display:block;color:var(--blue);font-size:56rpx;line-height:1}.diagram-line view label{display:block;margin-top:6rpx}
.measure-group,.matrix-panel{margin:28rpx 24rpx}.group-title{display:flex;justify-content:space-between;margin-bottom:12rpx}.group-title text{font-size:29rpx;font-weight:700}.group-title label{color:var(--text-2);font-size:21rpx}.metric-table{border:1rpx solid var(--line)}.metric-table>view{display:grid;grid-template-columns:150rpx 1fr 150rpx;min-height:82rpx;border-bottom:1rpx solid var(--line-soft)}.metric-table>view:last-child{border:0}.metric-table text,.metric-table input,.metric-table label{padding:18rpx;line-height:46rpx}.metric-table text{border-right:1rpx solid var(--line-soft)}.metric-table input{margin:8rpx 20rpx;padding:8rpx 20rpx;color:var(--blue);border:1rpx solid var(--blue)}.metric-table label{text-align:center;border-left:1rpx solid var(--line-soft)}.metric-table label.filled{color:var(--green)}
.matrix-picker,.result-picker{padding:20rpx;color:var(--blue);border:1rpx solid var(--line)}.matrix-panel scroll-view{margin-top:16rpx}.matrix-table{width:max-content;border:1rpx solid var(--line)}.matrix-row{display:flex}.matrix-row text,.matrix-row input{width:128rpx;min-height:72rpx;padding:8rpx;text-align:center;border-right:1rpx solid var(--line-soft);border-bottom:1rpx solid var(--line-soft)}.matrix-row>text:first-child{width:80rpx}.matrix-row.head{color:var(--blue)}
.result-panel>text{display:block;margin-bottom:8rpx}.result-panel textarea{width:100%;height:130rpx;margin-top:10rpx;padding:18rpx;border:1rpx solid var(--line)}.save-form,.complete-form{width:calc(100% - 48rpx);margin:18rpx 24rpx 0;font-size:32rpx;font-weight:700}.original-link{width:100%;color:var(--blue);background:transparent}

.process-form-screen{background:var(--bg);color:var(--text)}.form-meta,.diagram,.measure-group,.matrix-panel,.result-panel{background:#fff;border-radius:8rpx}.form-meta>view>text,.form-meta picker{min-width:0;overflow:hidden;text-overflow:ellipsis}.metric-table input,.matrix-row input,.result-panel textarea{color:var(--text);background:#fff}.save-form,.complete-form{white-space:nowrap}

.save-form,.complete-form,.original-link{
  display:flex;
  align-items:center;
  justify-content:center;
  min-height:88rpx;
  line-height:1.2;
  text-align:center;
  white-space:nowrap;
}
.original-link{min-height:72rpx;font-size:24rpx}

/* V7 form labels and measurements keep independent columns. */
.group-title{gap:16rpx;align-items:flex-start}.group-title text{flex:1;min-width:0;line-height:1.4;word-break:break-word}.group-title label{flex:0 0 auto;max-width:230rpx;line-height:1.4;text-align:right;word-break:break-word}
.metric-table>view{grid-template-columns:minmax(130rpx,150rpx) minmax(0,1fr) minmax(120rpx,150rpx)}
.metric-table text,.metric-table label{line-height:1.4;word-break:break-word}.metric-table input{min-width:0}
@media (max-width:360px){.form-meta,.measure-group,.matrix-panel{margin-left:18rpx;margin-right:18rpx}.form-meta label{width:130rpx;padding-left:14rpx;padding-right:14rpx}.metric-table>view{grid-template-columns:126rpx minmax(0,1fr) 112rpx}.metric-table text,.metric-table label{padding:14rpx 10rpx}.metric-table input{margin-left:10rpx;margin-right:10rpx;padding-left:10rpx;padding-right:10rpx}.save-form,.complete-form{height:auto;min-height:88rpx;white-space:normal}}
