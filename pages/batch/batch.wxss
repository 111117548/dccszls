/* pages/batch/batch.wxss */
.page-container {
  min-height: 100vh;
  background: #0c1225;
  padding-bottom: 120rpx;
}

/* Header */
.batch-header {
  padding: 40rpx 32rpx 24rpx;
  text-align: center;
}
.batch-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
}
.batch-subtitle {
  font-size: 24rpx;
  color: #64748b;
  margin-top: 8rpx;
}

.demo-notice {
  display: flex;
  align-items: center;
  margin: 0 24rpx 20rpx;
  padding: 18rpx 20rpx;
  border-left: 4rpx solid #ffc229;
  background: rgba(255, 194, 41, 0.08);
}
.demo-notice-tag {
  flex: none;
  padding: 4rpx 10rpx;
  border: 1rpx solid #ffc229;
  color: #ffc229;
  font-size: 20rpx;
  letter-spacing: 2rpx;
}
.demo-notice-content {
  margin-left: 18rpx;
  color: #f4f7f8;
  font-size: 24rpx;
}
.demo-notice-content text {
  display: block;
  margin-top: 4rpx;
  color: #82919a;
  font-size: 21rpx;
}

/* Upload Section */
.upload-section {
  margin: 24rpx;
}
.upload-area {
  border: 2rpx dashed #334155;
  border-radius: 16rpx;
  padding: 48rpx;
  text-align: center;
  background: #131b2e;
}
.upload-icon {
  font-size: 64rpx;
}
.upload-text {
  display: block;
  color: #94a3b8;
  font-size: 28rpx;
  margin-top: 16rpx;
}
.upload-hint {
  display: block;
  color: #475569;
  font-size: 22rpx;
  margin-top: 8rpx;
}

/* Photo Grid */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 24rpx;
}
.photo-thumb {
  width: calc(33.33% - 12rpx);
  aspect-ratio: 1;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
  background: #131b2e;
}
.photo-thumb image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.photo-remove {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 36rpx;
  height: 36rpx;
  background: rgba(0,0,0,0.6);
  border-radius: 50%;
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.photo-status {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 6rpx;
  text-align: center;
  font-size: 20rpx;
  color: #fff;
}
.photo-status.pending { background: rgba(100,116,139,0.8); }
.photo-status.analyzing { background: rgba(0,212,255,0.8); }
.photo-status.done { background: rgba(34,197,94,0.8); }
.photo-status.error { background: rgba(250,81,81,0.8); }

/* Action Button */
.action-section {
  padding: 24rpx;
}

/* Progress */
.progress-section {
  margin: 24rpx;
  padding: 32rpx;
  background: #131b2e;
  border-radius: 16rpx;
}
.progress-text {
  color: #94a3b8;
  font-size: 26rpx;
  margin-bottom: 16rpx;
}
.progress-bar {
  height: 8rpx;
  background: #1e293b;
  border-radius: 4rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #00d4ff, #22c55e);
  border-radius: 4rpx;
  transition: width 0.3s;
}

/* Results Section */
.results-section {
  padding: 24rpx;
}
.results-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 24rpx;
}

/* Result Card */
.result-card {
  background: #131b2e;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}
.result-photo {
  width: 100%;
  height: 300rpx;
  object-fit: cover;
}
.result-body {
  padding: 24rpx;
}
.result-photo-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 16rpx;
}
.result-summary {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.result-stat {
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}
.stat-major { background: rgba(250,81,81,0.2); color: #FA5151; }
.stat-moderate { background: rgba(255,195,0,0.2); color: #FFC300; }
.stat-minor { background: rgba(16,174,255,0.2); color: #10AEFF; }

/* Defect List in Result */
.defect-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #1e293b;
}
.defect-item:last-child { border-bottom: none; }
.defect-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.defect-num {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  font-size: 20rpx;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.defect-num.major { background: #FA5151; }
.defect-num.moderate { background: #FFC300; }
.defect-num.minor { background: #10AEFF; }
.defect-name {
  font-size: 26rpx;
  color: #e2e8f0;
  flex: 1;
}
.defect-desc {
  font-size: 24rpx;
  color: #94a3b8;
  margin-top: 8rpx;
  padding-left: 48rpx;
}
.defect-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
  padding-left: 48rpx;
}
.defect-action-btn {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  background: #1e293b;
  color: #94a3b8;
}
.defect-action-btn.confirmed {
  background: rgba(34,197,94,0.2);
  color: #22c55e;
}

/* No defects message */
.no-defects {
  text-align: center;
  color: #64748b;
  font-size: 26rpx;
  padding: 24rpx;
}

/* Export Section */
.export-section {
  padding: 24rpx;
}

/* Modal */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.7);
  z-index: 100;
}
.modal-content {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: 0;
  background: #131b2e;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 32rpx;
  z-index: 101;
  max-height: 70vh;
  overflow-y: auto;
}
.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 32rpx;
}
.edit-label {
  font-size: 24rpx;
  color: #94a3b8;
  margin-bottom: 8rpx;
}
.edit-input, .edit-textarea {
  width: 100%;
  background: #0c1225;
  border: 1rpx solid #334155;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  color: #e2e8f0;
  font-size: 28rpx;
  margin-bottom: 24rpx;
}
.edit-textarea {
  min-height: 120rpx;
}
.edit-picker {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #0c1225;
  border: 1rpx solid #334155;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  color: #e2e8f0;
  font-size: 28rpx;
  margin-bottom: 24rpx;
}

/* Buttons */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  line-height: 1;
}
.btn::after { border: none; }
.btn-primary {
  background: linear-gradient(135deg, #00d4ff, #0ea5e9);
  color: #fff;
}
.btn-outline {
  background: transparent;
  border: 1rpx solid #334155;
  color: #94a3b8;
}
.btn-success {
  background: linear-gradient(135deg, #22c55e, #16a34a);
  color: #fff;
}
.btn-sm {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
}
.btn-block {
  width: 100%;
}
.row {
  display: flex;
  gap: 16rpx;
}
.col {
  flex: 1;
}

/* Overall stats bar */
.overall-stats {
  display: flex;
  justify-content: space-around;
  padding: 24rpx;
  background: #131b2e;
  margin: 0 24rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}
.overall-stat-item {
  text-align: center;
}
.overall-stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
}
.overall-stat-label {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 4rpx;
}

.batch-review-state{margin:0 24rpx 20rpx;padding:18rpx 20rpx;background:#342f1e;border-left:6rpx solid #ffc229;color:#f1f5f6}
.batch-review-state text{display:block;color:#ffc229;font:15rpx monospace;letter-spacing:2rpx;margin-bottom:8rpx}.batch-review-state view{font-size:22rpx}
.batch-review-state.committed{background:#17352f;border-left-color:#2ed6a1}.batch-review-state.committed text{color:#2ed6a1}
.btn[disabled]{opacity:.45}

/* 方案C */
page{background:#14191c;color:#f4f7f8}.page-container{background:linear-gradient(180deg,#1b2225,#111618)}.batch-header{background:#252d30;border:2rpx solid #6a767b;border-left:7rpx solid #ffc229}.batch-title{color:#fff;font-size:34rpx}.batch-subtitle{color:#c0c8cb;font-size:22rpx}.upload-section,.action-section,.progress-section,.results-section,.export-section{background:#20272a;border-color:#657177;border-radius:0}.upload-area{background:#171d20;border:3rpx dashed #7b878c;border-radius:0}.upload-icon{color:#ffc229}.upload-text{color:#fff;font-size:29rpx}.upload-hint{color:#b4bec2;font-size:23rpx}.photo-thumb{border-radius:0;border-color:#68747a}.photo-status{border-radius:0}.progress-text{color:#e7eaeb}.progress-fill{background:#20c7c5}.results-title{color:#ffc229;font-size:30rpx}.result-card{background:#252d30;border:1rpx solid #657177;border-radius:0}.result-summary{color:#fff}.defect-item{border-bottom-color:#4d575c}.defect-name{color:#fff;font-size:27rpx}.defect-desc{color:#c5cdd0;font-size:24rpx}.defect-num{border-radius:0}.defect-num.major{background:#ff6258}.defect-num.moderate{color:#111619;background:#ffc229}.defect-num.minor{color:#111619;background:#20c7c5}.defect-action-btn{border-radius:0;color:#fff;background:#30383b;border-color:#747f84}.defect-action-btn.confirmed{color:#111619;background:#68e378}.no-defects{color:#68e378}.overall-stats{background:#252d30;border-color:#657177}.overall-stat-num{color:#ffc229}.overall-stat-label{color:#bdc6ca}.btn-success{color:#111619;background:#68e378}

/* V3.8 批量巡检触屏作业 */
.page-container{padding:24rpx;background:linear-gradient(180deg,#171e21,#101517)}
.batch-header{margin:0 0 24rpx;padding:28rpx;background:var(--color-neutral-850);border:2rpx solid var(--border-default);border-left:7rpx solid var(--color-primary)}.batch-title{font-size:38rpx}.batch-subtitle{margin-top:8rpx;color:var(--text-secondary);font-size:25rpx}
.upload-section,.action-section,.progress-section,.results-section,.export-section{margin:0 0 24rpx;padding:24rpx;background:var(--color-neutral-850);border:2rpx solid var(--border-default)}
.upload-area{display:flex;flex-direction:column;align-items:center;justify-content:center;width:100%;min-height:260rpx;margin:0;padding:30rpx;color:inherit;background:var(--color-neutral-950);border:3rpx dashed var(--border-strong);border-radius:var(--radius-sm);line-height:1.4}.upload-area::after{border:0}.upload-icon{font-size:64rpx}.upload-text{margin-top:16rpx;font-size:31rpx}.upload-hint{margin-top:8rpx;color:var(--text-secondary);font-size:24rpx}
.photo-grid{gap:16rpx;margin-bottom:24rpx}.photo-thumb{width:calc(33.333% - 11rpx);height:200rpx;border:2rpx solid var(--border-default);border-radius:var(--radius-sm);box-sizing:border-box}.photo-add-more{margin:0;padding:0;background:var(--color-neutral-850);line-height:1}.photo-remove{display:flex;align-items:center;justify-content:center;width:88rpx;height:88rpx;min-height:88rpx;margin:0;padding:0;color:#fff;background:#c94f49;border:2rpx solid #ff7b74;border-radius:var(--radius-sm);font-size:28rpx}
.overall-stats{display:flex;flex-wrap:wrap;justify-content:space-between;gap:1rpx;margin:0 0 24rpx;padding:0;background:var(--border-subtle);border:2rpx solid var(--border-default);border-radius:var(--radius-sm)}.overall-stat-item{width:20%;min-height:116rpx;padding:18rpx 4rpx;background:var(--color-neutral-850);box-sizing:border-box}.overall-stat-num{font-size:38rpx}.overall-stat-label{color:var(--text-secondary);font-size:21rpx}
.batch-review-state{margin:0 0 24rpx;padding:22rpx;background:#342f1e}.batch-review-state text{font-size:19rpx}.batch-review-state view{font-size:25rpx;line-height:1.5}
.result-card{margin-bottom:24rpx;background:var(--color-neutral-850);border:2rpx solid var(--border-default)}.result-photo{height:260rpx}.result-body{padding:24rpx}.result-photo-label{font-size:28rpx}.defect-desc{color:var(--text-secondary);font-size:25rpx;line-height:1.6}
.defect-actions{display:flex;gap:12rpx;margin-top:18rpx;padding-left:0}.defect-action-btn{flex:1;display:flex;align-items:center;justify-content:center;min-height:88rpx;margin:0;padding:10rpx 6rpx;color:var(--text-primary);background:var(--color-neutral-800);border:2rpx solid var(--border-default);border-radius:var(--radius-sm);font-size:22rpx;line-height:1.25}.defect-action-btn::after{border:0}
.export-section{padding-bottom:calc(24rpx + env(safe-area-inset-bottom))}.export-section .btn{min-height:96rpx}
.modal-content{left:16rpx;right:16rpx;padding:32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));background:var(--color-neutral-850);border:2rpx solid var(--border-strong);border-top:7rpx solid var(--color-primary);border-radius:var(--radius-sm) var(--radius-sm) 0 0}.edit-input,.edit-textarea,.edit-picker{min-height:88rpx;color:var(--text-primary);background:var(--color-neutral-950);border:2rpx solid var(--border-strong);border-radius:var(--radius-sm);font-size:27rpx;box-sizing:border-box}

/* V5.2 reference visual alignment */
page{background:#020d18}.page-container{background:radial-gradient(circle at 50% 5%,rgba(45,149,255,.12),transparent 34%),linear-gradient(180deg,#010812,#020d18)}
.batch-header{background:rgba(7,24,39,.92);border-color:var(--line);border-left-color:var(--blue)}
.upload-section,.action-section,.progress-section,.results-section,.export-section,.result-card,.overall-stat-item{background:rgba(7,24,39,.9);border-color:var(--line)}
.upload-area{background:#03111e;border-color:rgba(45,149,255,.5)}.upload-icon,.results-title,.overall-stat-num{color:var(--blue)}
.progress-fill{background:linear-gradient(90deg,var(--blue),var(--cyan))}
.defect-num.moderate{background:var(--yellow)}.defect-num.minor{background:var(--cyan)}
.defect-action-btn{background:#10263a;border-color:var(--line)}.defect-action-btn.confirmed{background:var(--green)}
.btn-primary,.btn-ai{color:#fff;background:linear-gradient(135deg,#1978dd,#1051af);border-color:var(--blue)}

/* V6 企业协同明亮主题 */
page{background:var(--bg);color:var(--text)}
.page-container{background:var(--bg);color:var(--text)}
.batch-header,.upload-section,.action-section,.progress-section,.results-section,.export-section,.result-card,.overall-stat-item{background:#fff;border-color:var(--line);box-shadow:var(--shadow-sm)}
.batch-header{border-left-color:var(--brand)}
.batch-title,.upload-text,.results-title,.result-summary,.defect-name,.overall-stat-num,.modal-title{color:var(--text)}
.batch-subtitle,.upload-hint,.defect-desc,.overall-stat-label,.edit-label{color:var(--text-2)}
.upload-area{background:#f8fbff;border-color:#9dbce3}
.upload-icon,.results-title{color:var(--brand)}
.photo-thumb{border-color:var(--line)}
.progress-text{color:var(--text)}
.progress-bar{background:#e8edf4}
.progress-fill{background:linear-gradient(90deg,var(--brand),var(--brand-2))}
.overall-stats{background:var(--line);border-color:var(--line);box-shadow:var(--shadow-sm)}
.overall-stat-num{color:var(--brand)}
.defect-item{border-bottom-color:var(--line)}
.defect-name,.defect-desc{min-width:0;overflow:hidden;text-overflow:ellipsis}
.defect-name{white-space:nowrap}.defect-desc{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2}
.defect-action-btn{min-width:0;color:var(--brand);background:#fff;border-color:#9dbce3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.defect-action-btn.confirmed{color:#fff;background:var(--success);border-color:var(--success)}
.no-defects{color:var(--success)}
.batch-review-state{color:var(--warning);background:var(--warning-soft);border-left-color:var(--warning)}
.batch-review-state text{color:var(--warning)}
.batch-review-state.committed{background:var(--success-soft);border-left-color:var(--success)}
.batch-review-state.committed text{color:var(--success)}
.modal-mask{background:rgba(15,35,58,.45)}
.modal-content{color:var(--text);background:#fff;border-color:var(--line);border-top-color:var(--brand);box-shadow:0 -18rpx 60rpx rgba(15,35,58,.14)}
.edit-input,.edit-textarea,.edit-picker{color:var(--text);background:#fff;border-color:var(--line)}
.btn-outline{color:var(--brand);background:#fff;border-color:#9dbce3}
.btn-primary,.btn-ai{background:linear-gradient(135deg,var(--brand),var(--brand-2));border-color:var(--brand)}

/* 上传入口为图文复合按钮，必须保留纵向布局。 */
.photo-add-more{
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  white-space:normal;
}
