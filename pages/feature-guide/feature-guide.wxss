.guide-page{min-height:100vh;padding-bottom:calc(44rpx + env(safe-area-inset-bottom));overflow:hidden;background:#eef3f8;color:#172536}
.guide-hero{position:relative;min-height:330rpx;padding:38rpx 36rpx 44rpx;overflow:hidden;background:linear-gradient(135deg,#07182b 0%,#0d2f50 68%,#0b4d74 100%);color:#fff}
.hero-grid{position:absolute;inset:0;opacity:.22;background-image:linear-gradient(rgba(76,178,232,.28) 1rpx,transparent 1rpx),linear-gradient(90deg,rgba(76,178,232,.28) 1rpx,transparent 1rpx);background-size:46rpx 46rpx;transform:perspective(500rpx) rotateX(58deg) scale(1.5);transform-origin:center bottom}
.guide-hero:after{position:absolute;right:-120rpx;bottom:-180rpx;width:430rpx;height:430rpx;border:2rpx solid rgba(57,186,255,.3);border-radius:50%;box-shadow:0 0 0 34rpx rgba(57,186,255,.04),0 0 0 70rpx rgba(57,186,255,.03);content:""}
.hero-top,.hero-kicker,.hero-title,.hero-purpose{position:relative;z-index:1}.hero-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:22rpx}.hero-icon{display:flex;width:72rpx;height:72rpx;align-items:center;justify-content:center;border:1rpx solid rgba(105,203,255,.55);border-radius:12rpx;background:rgba(18,93,137,.55)}.hero-icon image{width:48rpx;height:48rpx;filter:brightness(0) invert(1)}
.status-chip{padding:7rpx 18rpx;border:1rpx solid;border-radius:4rpx;font-size:20rpx}.status-chip.live{border-color:#66e5ae;color:#8ef0c2;background:rgba(22,132,91,.25)}.status-chip.planned{border-color:#ffd17a;color:#ffe2a8;background:rgba(215,139,0,.22)}
.hero-kicker{display:block;color:#65c9ff;font-size:18rpx;font-weight:600;letter-spacing:3rpx}.hero-title{display:block;margin-top:8rpx;font-size:48rpx;font-weight:800;letter-spacing:1rpx}.hero-purpose{display:block;max-width:620rpx;margin-top:14rpx;color:#c5d7e7;font-size:24rpx;line-height:1.65}
.feature-intro-card{margin:24rpx 24rpx 0;padding:28rpx 26rpx;border:1rpx solid #d9e6ee;border-top:6rpx solid #178bd6;border-radius:14rpx;background:#fff;box-shadow:0 8rpx 24rpx rgba(22,50,76,.06)}
.intro-kicker,.intro-title,.intro-description{display:block}.intro-kicker{color:#168bd3;font-size:19rpx;font-weight:700;letter-spacing:2rpx}.intro-title{margin-top:8rpx;color:#162b3c;font-size:32rpx;font-weight:800;line-height:1.35}.intro-description{margin-top:12rpx;color:#566d7e;font-size:22rpx;line-height:1.72}
.problem-box{display:flex;align-items:flex-start;margin-top:22rpx;padding:20rpx;border:1rpx solid #e5d3a9;border-radius:10rpx;background:#fffaf0}.problem-icon{display:flex;flex:0 0 38rpx;width:38rpx;height:38rpx;align-items:center;justify-content:center;margin-right:14rpx;border-radius:6rpx;color:#fff;background:#d78b00;font-size:23rpx;font-weight:800}.problem-box>view:last-child{flex:1}.problem-box text,.problem-box label{display:block}.problem-box text{color:#755411;font-size:22rpx;font-weight:700}.problem-box label{margin-top:5rpx;color:#74633f;font-size:21rpx;line-height:1.65}
.capability-heading{display:flex;align-items:center;justify-content:space-between;margin-top:28rpx;padding-bottom:14rpx;border-bottom:1rpx solid #e5edf2}.capability-heading text{color:#1b3344;font-size:27rpx;font-weight:800}.capability-heading label{color:#178bd6;font-size:19rpx}.capability-item{display:flex;align-items:flex-start;padding:20rpx 0;border-bottom:1rpx solid #edf2f5}.capability-item:last-child{padding-bottom:4rpx;border-bottom:0}.capability-number{display:flex;flex:0 0 58rpx;width:58rpx;height:58rpx;align-items:center;justify-content:center;margin-right:16rpx;border:1rpx solid #91c8e6;border-radius:8rpx;color:#0c7dbd;background:#edf8fe;font-family:monospace;font-size:20rpx;font-weight:700}.capability-copy{flex:1;min-width:0}.capability-copy text,.capability-copy label{display:block}.capability-copy text{color:#172c3d;font-size:25rpx;font-weight:750}.capability-copy label{margin-top:5rpx;color:#65798a;font-size:20rpx;line-height:1.6}
.guide-tip{display:flex;align-items:flex-start;margin:24rpx 24rpx 0;padding:20rpx 22rpx;border:1rpx solid #a9d7ef;border-left:6rpx solid #168bd3;border-radius:10rpx;background:#f5fbff}.tip-mark{display:flex;flex:0 0 34rpx;width:34rpx;height:34rpx;align-items:center;justify-content:center;margin-right:14rpx;border-radius:50%;color:#fff;background:#168bd3;font-size:22rpx;font-weight:700}.guide-tip text{flex:1;color:#36536a;font-size:22rpx;line-height:1.6}
.steps-heading{display:flex;align-items:flex-end;justify-content:space-between;padding:34rpx 28rpx 18rpx}.steps-heading>view>text,.steps-heading>view>label{display:block}.steps-heading>view>text{font-size:34rpx;font-weight:800}.steps-heading>view>label{margin-top:4rpx;color:#748596;font-size:20rpx}.step-count{color:#168bd3;font-size:20rpx}
.step-list{padding:0 24rpx}.step-card{position:relative;margin-bottom:18rpx;overflow:hidden;border:1rpx solid #dce6ee;border-radius:14rpx;background:#fff;box-shadow:0 6rpx 20rpx rgba(22,50,76,.05)}.step-card.expanded{border-color:#80badb;box-shadow:0 10rpx 28rpx rgba(20,95,139,.1)}.step-card:before{position:absolute;top:0;bottom:0;left:0;width:5rpx;background:#168bd3;content:""}
.step-head{display:flex;min-height:116rpx;align-items:center;padding:20rpx 20rpx 20rpx 24rpx}.step-pressed{background:#f4f9fc}.step-number{display:flex;flex:0 0 66rpx;width:66rpx;height:66rpx;align-items:center;justify-content:center;margin-right:18rpx;border:1rpx solid #9bcbe4;border-radius:8rpx;color:#0e77b5;background:#ecf8ff}.step-number text{font-family:monospace;font-size:22rpx;font-weight:700}.step-copy{flex:1;min-width:0}.step-copy text,.step-copy label{display:block}.step-copy text{font-size:28rpx;font-weight:750}.step-copy label{margin-top:5rpx;color:#687b8d;font-size:21rpx;line-height:1.45}.step-toggle{display:flex;flex:0 0 48rpx;width:48rpx;height:48rpx;align-items:center;justify-content:center;margin-left:10rpx;border:1rpx solid #b7d4e4;border-radius:50%;color:#107ebd;font-size:32rpx;font-weight:300}
.step-detail{padding:0 22rpx 24rpx 108rpx;border-top:1rpx solid #edf1f4;background:linear-gradient(180deg,#fbfdff,#fff)}.detail-row{display:flex;align-items:flex-start;padding-top:22rpx}.detail-symbol{display:flex;flex:0 0 34rpx;width:34rpx;height:34rpx;align-items:center;justify-content:center;margin-right:12rpx;border-radius:5rpx;color:#fff;background:#178bd6;font-size:19rpx;font-weight:700}.detail-row.warning .detail-symbol{background:#d78b00}.detail-row>view:last-child{flex:1}.detail-row text,.detail-row label{display:block}.detail-row text{color:#31546e;font-size:22rpx;font-weight:700}.detail-row label{margin-top:4rpx;color:#607487;font-size:21rpx;line-height:1.65}.detail-row.warning label{color:#735c31}
.screen-example{margin-top:24rpx;overflow:hidden;border:1rpx solid #bfd5e2;border-radius:8rpx;background:#f2f7fa}.screen-toolbar{display:flex;height:38rpx;align-items:center;padding:0 12rpx;background:#dce8ef}.screen-dot{width:9rpx;height:9rpx;margin-right:7rpx;border-radius:50%;background:#9db4c2}.screen-dot.first{background:#e47f6e}.screen-toolbar text{margin-left:auto;color:#698092;font-size:16rpx}.screen-body{position:relative;height:142rpx;padding:22rpx;background:linear-gradient(135deg,#f7fbfd,#e8f2f7)}.screen-line{width:56%;height:9rpx;margin-bottom:11rpx;border-radius:5rpx;background:#c4d9e5}.screen-line.strong{width:38%;background:#6aaed3}.screen-panels{display:flex;gap:10rpx;margin-top:18rpx}.screen-panels view{height:46rpx;flex:1;border:1rpx solid #bfd4df;background:#fff}.screen-button{position:absolute;right:22rpx;bottom:22rpx;width:100rpx;height:28rpx;border-radius:3rpx;background:#178bd6}.screen-caption{display:block;padding:11rpx 14rpx;color:#5a7181;background:#fff;font-size:18rpx;text-align:center}
.guide-photo{margin-top:24rpx;overflow:hidden;border:1rpx solid #bfd5e2;border-radius:8rpx;background:#fff}.guide-photo image{display:block;width:100%;height:auto}.guide-photo text{display:block;padding:12rpx;color:#5a7181;font-size:18rpx;text-align:center}
.guide-footer{padding:16rpx 24rpx 50rpx;text-align:center}.continue-button{min-height:92rpx;color:#fff;background:linear-gradient(90deg,#0c6eab,#1898da);border:0;border-radius:8rpx;font-size:28rpx;font-weight:700;box-shadow:0 8rpx 22rpx rgba(15,118,178,.22)}.continue-button.disabled{color:#6f7f8c;background:#d9e1e6;box-shadow:none}.guide-footer>text{display:block;margin-top:18rpx;color:#84919d;font-size:19rpx}
@media (max-width:360px){.guide-hero{padding-left:28rpx;padding-right:28rpx}.step-detail{padding-left:22rpx;padding-right:18rpx;padding-bottom:22rpx}.step-number{flex-basis:58rpx;width:58rpx;height:58rpx}.step-copy text{font-size:26rpx}}
