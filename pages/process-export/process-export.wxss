.export-screen{padding:50rpx 34rpx}.export-hero{text-align:center}.export-hero text,.export-hero label{display:block}.export-hero text{font-size:52rpx;font-weight:800;letter-spacing:3rpx}.export-hero label{margin-top:6rpx;color:var(--text-2);font-size:25rpx}.export-hero::after{display:block;width:220rpx;height:3rpx;margin:14rpx auto 32rpx;background:linear-gradient(90deg,transparent,var(--blue),transparent);content:""}
.export-list{border:1rpx solid var(--line)}.export-list view{display:flex;align-items:center;justify-content:space-between;min-height:82rpx;padding:0 30rpx;border-bottom:1rpx solid var(--line-soft)}.export-list view:last-child{border:0}.export-list text{font-size:27rpx;font-weight:700}.export-list label{color:var(--text-3)}.export-list label.done{color:var(--green)}.export-button{width:100%;margin:30rpx 0;font-size:34rpx;font-weight:800}
.file-result{display:flex;flex-wrap:wrap;align-items:center;padding:26rpx;border:2rpx solid var(--blue);border-radius:8rpx}.excel-icon{width:88rpx;height:88rpx;margin-right:22rpx;color:#fff;font-size:44rpx;font-weight:800;text-align:center;line-height:88rpx;background:#138344}.file-result>view:nth-child(2){flex:1;min-width:0}.file-result>view:nth-child(2) text,.file-result>view:nth-child(2) label{display:block}.file-result>view:nth-child(2) text{overflow:hidden;font-size:25rpx;font-weight:700;white-space:nowrap;text-overflow:ellipsis}.file-result>view:nth-child(2) label{margin-top:8rpx;color:var(--text-2);font-size:20rpx}.file-actions{display:flex;gap:18rpx;width:100%;margin-top:24rpx;padding-top:22rpx;border-top:1rpx solid var(--line)}.file-actions button{flex:1;color:var(--text-2);background:transparent;border:1rpx solid var(--line)}.file-actions .outline-btn{color:var(--blue);border-color:var(--blue)}.print-note{display:block;margin-top:28rpx;color:var(--text-2);text-align:center}
.export-mode-note{margin:-12rpx 0 28rpx;padding:18rpx 20rpx;background:rgba(45,149,255,.06);border-left:4rpx solid var(--blue)}.export-mode-note text,.export-mode-note label{display:block}.export-mode-note text{color:var(--blue);font-size:21rpx;line-height:1.55}.export-mode-note label{margin-top:6rpx;color:var(--text-2);font-size:19rpx;line-height:1.5}
.export-mode-note.status-ready{border-left-color:var(--green)}.export-mode-note.status-ready text{color:var(--green)}.export-mode-note.status-unavailable{border-left-color:var(--yellow)}.export-mode-note.status-unavailable text{color:var(--yellow)}
.original-scope{margin:0 0 24rpx;padding:20rpx 24rpx;border:1rpx solid var(--line);background:rgba(45,149,255,.04)}.original-scope text,.original-scope label{display:block}.original-scope text{color:var(--blue);font-size:24rpx;font-weight:700}.original-scope label{margin-top:8rpx;color:var(--text-2);font-size:21rpx;letter-spacing:1rpx}

.export-screen{background:var(--bg);color:var(--text)}.export-list,.file-result,.original-scope{background:#fff}.export-mode-note{background:#eef5ff}.export-button{white-space:nowrap}

.export-button,.file-actions button{
  display:flex;
  align-items:center;
  justify-content:center;
  min-width:0;
  line-height:1.2;
  text-align:center;
  white-space:nowrap;
}

/* V7 export actions and long filenames */
.export-button,.file-actions button{height:auto;min-height:84rpx;padding-top:12rpx;padding-bottom:12rpx;white-space:normal}
.export-list view{gap:16rpx}.export-list text{flex:1;min-width:0;line-height:1.4;word-break:break-word}.export-list label{flex:0 0 auto;max-width:190rpx;overflow:hidden;white-space:normal;text-align:right;text-overflow:ellipsis}
@media (max-width:360px){.export-screen{padding-left:22rpx;padding-right:22rpx}.export-hero text{font-size:46rpx}.file-actions{gap:12rpx}.file-actions button{padding-left:10rpx;padding-right:10rpx}}
