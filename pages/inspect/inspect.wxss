.smart-overview-card .smart-overview-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin:24rpx 0 0;padding:22rpx 0 0;border:0;border-top:1rpx solid var(--line-soft);border-radius:0;box-shadow:none}.smart-overview-card .smart-overview-stats view{min-width:0}.smart-overview-card .smart-overview-stats label{font-size:20rpx}.smart-overview-card .smart-overview-stats text{font-size:36rpx}
.smart-section-head text,.smart-section-head label{display:block}.smart-section-head text{font-size:29rpx;font-weight:700}.smart-section-head label{margin-top:5rpx;color:var(--text-3);font-size:20rpx;line-height:1.45}
.detection-flow{display:flex;align-items:flex-start;justify-content:space-between;margin-top:24rpx}.detection-flow>view{flex:1;min-width:0;text-align:center}.detection-flow>view>text{display:flex;align-items:center;justify-content:center;width:52rpx;height:52rpx;margin:auto;color:#fff;font-size:22rpx;font-weight:700;border-radius:50%;background:var(--brand)}.detection-flow>view>label{display:block;margin-top:9rpx;color:var(--text-2);font-size:18rpx;line-height:1.35}.detection-flow .flow-arrow{flex:none;margin:12rpx 5rpx 0;color:#91b6e2;font-size:24rpx}
.detection-action-card .start-ai{width:100%;height:88rpx;min-height:88rpx;margin:24rpx 0 12rpx;padding:0 18rpx;border-radius:16rpx}.detection-action-card .start-ai label{font-size:29rpx}.detection-action-card .album-entry{width:100%;min-height:70rpx;margin:0;padding:0;color:var(--brand);font-size:22rpx;line-height:68rpx;border:1rpx solid #91caff;border-radius:16rpx;background:#fff}
.task-section-head{display:flex;align-items:flex-end;justify-content:space-between;gap:20rpx;margin:30rpx 30rpx 14rpx}.task-section-head text{font-size:30rpx;font-weight:700}.task-section-head label{color:var(--text-3);font-size:20rpx}.recent-empty{margin:0 28rpx;padding:48rpx 24rpx;border-color:var(--line-soft);border-radius:20rpx;background:#fff}
@media (max-width:360px){.smart-overview-card,.detection-flow-card,.detection-action-card{margin-right:18rpx;margin-left:18rpx;padding-right:20rpx;padding-left:20rpx}.detection-flow .flow-arrow{margin-right:1rpx;margin-left:1rpx}.detection-flow>view>label{font-size:16rpx}.detection-action-card .start-ai{width:100%;min-height:88rpx;margin-right:0;margin-left:0}.detection-action-card .start-ai label{font-size:27rpx}.recent-empty{margin-right:18rpx;margin-left:18rpx}}
