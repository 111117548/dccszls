/* Enterprise light overrides */
.ai-screen{background:var(--bg);color:var(--text)}
.ai-subnav{background:#fff;border-color:var(--line)}.ai-subnav>view.active{background:#eef5ff}
.subnav-reminder{top:13rpx;right:calc(50% - 80rpx)}.ai-stats .stat-reminder{top:4rpx;right:18rpx}.recent-task .task-reminder{top:8rpx;right:8rpx}
.start-ai{color:#fff;background:linear-gradient(135deg,#0b4aa2,#1467c9);border-color:#0b4aa2;box-shadow:0 10rpx 26rpx rgba(11,74,162,.18)}.ai-chip{border-color:#fff;box-shadow:none}.album-entry{color:var(--text-2)}
.recent-task{color:var(--text);background:#fff;border-color:var(--line);border-radius:8rpx}.recent-task>view:nth-child(2){min-width:0}.recent-task view text,.recent-task view label{overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.config-row picker view,.config-row input{color:var(--text);background:#fff;border-color:var(--line)}
.analysis-progress,.result-progress{background:#e2e9f1}.annotate-canvas{background:#eef2f6}

/* 最近任务：固定图标 / 文案 / 状态三栏，避免长标题和状态相互挤压。 */
.recent-task{
  display:flex;
  align-items:center;
  gap:12rpx;
  width:calc(100% - 56rpx)!important;
  max-width:none;
  min-height:116rpx;
  margin:0 28rpx 16rpx;
  padding:18rpx 20rpx;
  overflow:visible;
  box-sizing:border-box;
  text-align:left;
  background:#fff;
  border:1rpx solid var(--line);
  border-radius:10rpx;
  box-shadow:0 6rpx 18rpx rgba(31,78,121,.07);
}
.recent-task>view.task-icon{
  display:flex;
  flex:0 0 60rpx;
  align-items:center;
  justify-content:center;
  width:60rpx;
  min-width:60rpx;
  height:60rpx;
  padding-left:0;
  color:var(--blue);
  font-size:32rpx;
  text-align:center;
  background:var(--brand-soft);
  border:1rpx solid #b8d0ee;
  border-radius:8rpx;
}
.recent-task>view.task-icon text{display:block;line-height:1}
.recent-task>view.task-icon image{display:block;width:42rpx;height:42rpx;margin:0}
.recent-task>view.task-copy{
  flex:1;
  min-width:0;
  padding:0;
}
.recent-task .task-title,
.recent-task .task-meta{
  display:block;
  max-width:100%;
  overflow:visible;
  white-space:normal;
  word-break:break-all;
}
.recent-task .task-title{
  color:var(--text);
  font-size:27rpx;
  font-weight:700;
  line-height:1.4;
}
.recent-task .task-meta{
  margin-top:5rpx;
  color:var(--text-3);
  font-size:20rpx;
  line-height:1.35;
}
.recent-task>view.task-trailing{
  display:flex;
  flex:0 0 118rpx;
  align-items:center;
  justify-content:flex-end;
  min-width:118rpx;
  margin-left:4rpx;
  padding:0;
}
.recent-task .task-state{
  display:block;
  max-width:92rpx;
  margin:0;
  overflow:hidden;
  font-size:23rpx;
  line-height:1.2;
  white-space:nowrap;
  text-overflow:ellipsis;
}
.recent-task .task-arrow{
  flex:0 0 auto;
  margin-left:10rpx;
  color:var(--text-2);
  font-size:36rpx;
  line-height:1;
}
.recent-task .task-reminder{top:9rpx;right:9rpx}
.quality-chips view{background:#fff}.quality-warning,.result-note{background:#fff8e8;border-color:#e6c574}
.defect-tools button,.add-missed{background:#fff}.confirm-table text{min-width:0;overflow:hidden;text-overflow:ellipsis}.defect-desc{word-break:break-all}
.check-tab{color:var(--text-2);background:#fff}.check-tab.active{color:#fff;background:var(--blue)}.check-standard{background:#eef5ff}
.check-title{min-width:0}.check-title label{overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.check-desc{display:-webkit-box;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:2}
.capture-actions button,.result-actions button,.committed-actions button,.check-bottom button{min-width:0;padding:0 16rpx;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.ai-stats .reminder-dot{flex:none;width:16rpx;height:16rpx;text-align:initial;border:3rpx solid #fff}

/* 任务卡是信息容器，按钮本体保持左对齐；启动按钮保持单行居中。 */
.recent-task{
  justify-content:flex-start;
  white-space:normal;
}
.start-ai{
  flex-direction:row;
  justify-content:center;
  white-space:nowrap;
}

/* 业务操作按钮：固定网格、固定高度和文字基线，窄屏也不发生上下错位。 */
.capture-actions,.result-actions,.committed-actions,.check-bottom{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:16rpx;
  padding:0 28rpx;
}
.capture-actions button,.result-actions button,.committed-actions button,.check-bottom button{
  display:flex;
  align-items:center;
  justify-content:center;
  width:100%;
  height:84rpx;
  min-height:84rpx;
  padding:0 14rpx;
  font-size:27rpx;
  font-weight:600;
  line-height:1.2;
  text-align:center;
  white-space:nowrap;
}
.result-actions .warning-btn{font-size:25rpx}
.result-actions button[disabled]{color:var(--text-3);background:#eef1f5;border-color:#cbd5df;box-shadow:none}
.defect-tools{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14rpx}
.defect-tools button{
  display:flex;
  align-items:center;
  justify-content:center;
  width:100%;
  height:68rpx;
  min-height:68rpx;
  padding:0 12rpx;
  font-size:25rpx;
  line-height:1.2;
  white-space:nowrap;
}
.add-missed{
  display:flex;
  align-items:center;
  justify-content:center;
  min-height:78rpx;
  padding:0 18rpx;
  font-size:26rpx;
  line-height:1.2;
  white-space:nowrap;
}
.capture-photo button,.check-actions button,.sheet-head button{
  display:flex;
  align-items:center;
  justify-content:center;
  line-height:1.2;
}
@media (max-width:360px){
  .capture-actions button,.result-actions button,.committed-actions button,.check-bottom button{padding:0 10rpx;font-size:25rpx}
  .result-actions .warning-btn{font-size:23rpx}
}

@media (max-width:360px){
  .capture-actions button,.result-actions button,.committed-actions button,.check-bottom button{height:auto;min-height:84rpx;padding:10rpx;font-size:25rpx;white-space:normal}
  .start-ai{height:auto;min-height:118rpx;margin-left:28rpx;margin-right:28rpx;padding:18rpx}
  .ai-chip{flex:0 0 68rpx;width:68rpx;height:68rpx;margin-right:20rpx;line-height:68rpx}
  .start-ai label{font-size:36rpx;white-space:normal}
  .check-actions button{height:auto;min-height:72rpx;padding:8rpx;line-height:1.25}
}

/* Ant-style AI flow: clear tabs, one primary action and quiet cards. */
.ai-screen{background:var(--bg);color:var(--text)}
.ai-subnav{border-color:var(--line-soft);background:#fff}.ai-subnav>view.active{color:#1677ff}.ai-subnav>view.active:after{background:#1677ff}
.start-ai{border-radius:20rpx;background:#1677ff;box-shadow:none}.album-entry{color:#1677ff;border-color:#91caff;border-radius:16rpx}
.ai-stats,.capture-config,.analysis-state,.defect-confirm,.check-progress,.check-card{border-color:var(--line-soft);border-radius:24rpx;box-shadow:var(--shadow-sm)}
.recent-task{border-color:var(--line-soft);border-radius:20rpx;box-shadow:var(--shadow-sm)}.recent-task:active{background:#f5faff}.task-arrow{color:#bfbfbf}
.check-tabs{background:var(--bg)}.check-tab{border-radius:999rpx}.check-tab.active{color:#1677ff;border-color:#91caff;background:#e6f4ff}
.capture-actions button,.result-actions button,.committed-actions button,.check-bottom button{border-radius:16rpx}

/* Keep the primary action readable on every phone width. */
.start-ai{width:calc(100% - 96rpx);height:96rpx;min-height:96rpx;margin:32rpx 48rpx 16rpx;padding:0 24rpx;overflow:visible;border:0}
.start-ai label{display:block;width:100%;overflow:visible;font-size:34rpx;font-weight:600;line-height:1.2;text-align:center;white-space:nowrap;text-overflow:clip}
@media (max-width:360px){.start-ai{width:calc(100% - 56rpx);min-height:92rpx;margin-right:28rpx;margin-left:28rpx;padding:0 16rpx}.start-ai label{font-size:31rpx;white-space:nowrap}}

/* 独立智能检测工作流：概况、步骤、操作和未闭环任务分层。 */
.smart-overview-card,.detection-flow-card,.detection-action-card{margin:22rpx 28rpx 0;padding:26rpx;border:1rpx solid var(--line-soft);border-radius:24rpx;background:#fff;box-shadow:var(--shadow-sm)}
