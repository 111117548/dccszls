.simple-workbench{padding-bottom:calc(40rpx + env(safe-area-inset-bottom));background:var(--bg)}
.workbench-heading{padding:34rpx 28rpx 20rpx}.workbench-heading text,.workbench-heading label{display:block}.workbench-heading text{font-size:40rpx;font-weight:700;line-height:1.3}.workbench-heading label{margin-top:6rpx;color:var(--text-3);font-size:22rpx}
.workbench-context{display:flex;min-height:118rpx;align-items:center;margin:0 24rpx 30rpx;padding:20rpx 24rpx;color:#fff;border-radius:24rpx;background:linear-gradient(135deg,#1677ff,#4096ff);box-shadow:0 12rpx 28rpx rgba(22,119,255,.16)}
.workbench-context>view{flex:1;min-width:0}.workbench-context label,.workbench-context>view text{display:block;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.workbench-context label{color:rgba(255,255,255,.72);font-size:19rpx}.workbench-context>view text{margin-top:5rpx;font-size:25rpx;font-weight:600}.workbench-context>text{flex:0 0 auto;max-width:180rpx;margin-left:20rpx;padding:7rpx 14rpx;overflow:hidden;font-size:19rpx;white-space:nowrap;text-overflow:ellipsis;border:1rpx solid rgba(255,255,255,.45);border-radius:999rpx}
.workbench-section{display:block;margin:0 28rpx 14rpx;font-size:26rpx;font-weight:600}
.tool-panel{margin:0 24rpx;overflow:hidden;border:1rpx solid var(--line-soft);border-radius:24rpx;background:#fff;box-shadow:var(--shadow-sm)}
.tool-item{display:flex;min-height:112rpx;align-items:center;margin-left:24rpx;padding:18rpx 24rpx 18rpx 0;border-bottom:1rpx solid var(--line-soft)}.tool-item:last-child{border-bottom:0}.tool-item-press{background:#f5faff}
.tool-icon{display:flex;width:70rpx;height:70rpx;flex:0 0 70rpx;align-items:center;justify-content:center;margin-right:20rpx;border-radius:18rpx;background:#e6f4ff}.tool-icon image{width:42rpx;height:42rpx}
.tool-copy{flex:1;min-width:0}.tool-copy text,.tool-copy label{display:block;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.tool-copy text{font-size:26rpx;font-weight:600}.tool-copy label{margin-top:4rpx;color:var(--text-3);font-size:20rpx}.tool-arrow{flex:0 0 auto;margin-left:16rpx;color:#bfbfbf;font-size:36rpx}
.workbench-note{display:block;margin-top:32rpx;color:var(--text-3);font-size:19rpx;text-align:center}
@media (max-width:360px){.workbench-heading{padding-left:22rpx}.workbench-context,.tool-panel{margin-right:18rpx;margin-left:18rpx}}
