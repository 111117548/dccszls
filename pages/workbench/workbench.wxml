<view class="screen simple-workbench">
  <view class="shared-brand-bar"><image src="/images/brand/zijin-longking-horizontal.png" mode="aspectFit" aria-label="紫金龙净"></image><view><text>工程质量数字化平台</text><label>ENGINEERING QUALITY</label></view></view>
  <view class="workbench-heading">
    <text>工作台</text><label>施工业务统一入口</label>
  </view>
  <view class="workbench-context">
    <view><label>当前项目</label><text>{{projectName}}</text></view>
    <text>{{deviceName}}</text>
  </view>
  <text class="workbench-section">全部功能</text>
  <view class="tool-panel">
    <view wx:for="{{tools}}" wx:key="action" class="tool-item" data-action="{{item.action}}" bindtap="openTool" hover-class="tool-item-press" role="button">
      <view class="tool-icon"><image src="{{item.icon}}" mode="aspectFit" aria-label="{{item.name}}"></image></view>
      <view class="tool-copy"><text>{{item.name}}</text><label>{{item.caption}}</label></view>
      <text class="tool-arrow">›</text>
    </view>
  </view>
  <text class="workbench-note">飞书同步作为质量检查台账的整改数据来源</text>
</view>
