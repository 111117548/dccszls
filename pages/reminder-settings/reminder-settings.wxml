<view class="screen reminder-screen">
  <view class="reminder-context">
    <view class="reminder-context-icon">🔔</view>
    <view><text>{{project.name || '当前项目'}}</text><label>{{device.name || '全部炉号'}}</label></view>
  </view>

  <view class="reminder-intro">
    <text>微信提醒中心</text>
    <label>提醒将通过微信“服务通知”发送。每项提醒都需要接收人主动授权。</label>
  </view>

  <view class="reminder-loading" wx:if="{{loading}}">正在读取提醒设置…</view>
  <view class="reminder-error" wx:elif="{{errorText}}"><text>{{errorText}}</text><button bindtap="loadSettings">重新读取</button></view>

  <block wx:else>
    <view class="reminder-card">
      <view class="reminder-card-head">
        <view class="reminder-type-icon blue">发</view>
        <view><text>发货节点预警</text><label>达到安装阈值后提醒项目负责人</label></view>
        <text class="state {{subscriptions.dispatch.enabled ? 'on' : ''}}">{{subscriptions.dispatch.enabled ? '已开启' : subscriptions.dispatch.needsRenewal ? '需续订' : '未开启'}}</text>
      </view>
      <view class="reminder-rule"><text>触发方式</text><label>进度跨越设定节点后，5分钟内检查并提醒</label></view>
      <view class="reminder-rule"><text>防重复</text><label>同一项目、炉号和发货条件只提醒一次</label></view>
      <view class="reminder-mode" wx:if="{{config.dispatch.mode === 'one_time'}}">一次性订阅：每发送一条消息后需要重新授权下一条。</view>
      <button wx:if="{{!subscriptions.dispatch.enabled}}" class="primary" data-type="dispatch" bindtap="enableReminder" loading="{{savingType === 'dispatch'}}">{{subscriptions.dispatch.needsRenewal ? '续订下一次提醒' : '开启发货预警'}}</button>
      <button wx:else class="secondary" data-type="dispatch" bindtap="disableReminder" loading="{{savingType === 'dispatch'}}">关闭提醒</button>
    </view>

    <view class="reminder-card">
      <view class="reminder-card-head">
        <view class="reminder-type-icon orange">周</view>
        <view><text>飞书整改周报</text><label>汇总待整改、待复验和逾期任务</label></view>
        <text class="state {{subscriptions.weekly.enabled ? 'on' : ''}}">{{subscriptions.weekly.enabled ? '已开启' : subscriptions.weekly.needsRenewal ? '需续订' : '未开启'}}</text>
      </view>
      <view class="schedule-row">
        <picker mode="selector" range="{{weekDays}}" range-key="label" value="{{weekDayIndex}}" bindchange="onWeekDayChange"><view>{{weekDays[weekDayIndex].label}}　⌄</view></picker>
        <picker mode="time" value="{{weeklyTime}}" bindchange="onWeeklyTimeChange"><view>{{weeklyTime}}　⌄</view></picker>
      </view>
      <view class="reminder-rule"><text>发送条件</text><label>只有存在未闭环任务时才发送</label></view>
      <view class="reminder-mode" wx:if="{{config.weekly.mode === 'one_time'}}">一次性订阅：发送本周周报后需要续订下一次。</view>
      <button wx:if="{{!subscriptions.weekly.enabled}}" class="primary" data-type="weekly" bindtap="enableReminder" loading="{{savingType === 'weekly'}}">{{subscriptions.weekly.needsRenewal ? '续订下一期周报' : '开启每周提醒'}}</button>
      <button wx:else class="secondary" data-type="weekly" bindtap="disableReminder" loading="{{savingType === 'weekly'}}">关闭提醒</button>
    </view>

    <view class="reminder-card contractor-card">
      <view class="reminder-card-head">
        <view class="reminder-type-icon green">催</view>
        <view><text>施工队整改催办</text><label>每天检查尚未提交的分享任务</label></view>
        <text class="state {{config.contractor.templateConfigured ? 'on' : ''}}">{{config.contractor.templateConfigured ? '可使用' : '待配置'}}</text>
      </view>
      <view class="contractor-steps">
        <view><text>1</text><label>分享整改任务</label></view><text>→</text>
        <view><text>2</text><label>施工队打开链接</label></view><text>→</text>
        <view><text>3</text><label>施工队主动开启提醒</label></view>
      </view>
      <view class="reminder-rule"><text>停止条件</text><label>提交整改资料、进入待复验或任务闭环</label></view>
      <button class="secondary" bindtap="goRectification">查看整改任务</button>
    </view>
  </block>

  <view class="reminder-footnote">
    <text>提醒说明</text>
    <label>若微信后台未开放长期订阅模板，普通订阅消息发送一次后即消耗一次授权。系统会保留站内红点提醒，并提示接收人续订。</label>
  </view>
</view>
