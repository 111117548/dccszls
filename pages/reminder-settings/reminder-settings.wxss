.reminder-screen{min-height:100vh;padding:22rpx 22rpx 54rpx;background:#f4f7fb;color:#172437;box-sizing:border-box}.reminder-context,.reminder-card,.reminder-footnote,.reminder-overview-card{border:1rpx solid #d8e2ee;border-radius:14rpx;background:#fff;box-shadow:0 6rpx 18rpx rgba(25,52,82,.05)}
.reminder-context{display:flex;align-items:center;padding:20rpx}.reminder-context-icon{display:flex;width:64rpx;height:64rpx;align-items:center;justify-content:center;margin-right:16rpx;border-radius:12rpx;background:#eef5ff;font-size:30rpx}.reminder-context>view:last-child{min-width:0}.reminder-context text,.reminder-context label{display:block;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.reminder-context text{font-size:27rpx;font-weight:700}.reminder-context label{margin-top:5rpx;color:#778496;font-size:20rpx}
.reminder-intro{padding:26rpx 24rpx}.reminder-intro text,.reminder-intro label{display:block}.reminder-intro .reminder-overview-kicker{color:var(--brand);font-size:20rpx;font-weight:600}.reminder-intro .reminder-overview-title{margin-top:5rpx;font-size:34rpx;font-weight:800}.reminder-intro label{margin-top:8rpx;color:#6a7788;font-size:21rpx;line-height:1.5}.reminder-loading,.reminder-error{margin-top:12rpx;padding:60rpx 24rpx;color:#758297;text-align:center;border:1rpx dashed #c7d4e4;border-radius:14rpx;background:#fff}.reminder-error button{width:210rpx;margin:22rpx auto 0;color:#0b4aa2;border:1rpx solid #0b4aa2;background:#fff}
.reminder-card{margin-top:18rpx;padding:22rpx}.reminder-card-head{display:flex;align-items:center}.reminder-card-head>view:nth-child(2){flex:1;min-width:0}.reminder-card-head text,.reminder-card-head label{display:block}.reminder-card-head>view:nth-child(2)>text{font-size:28rpx;font-weight:750}.reminder-card-head label{margin-top:5rpx;color:#778496;font-size:19rpx;line-height:1.4}.reminder-type-icon{display:flex;flex:0 0 60rpx;width:60rpx;height:60rpx;align-items:center;justify-content:center;margin-right:14rpx;border-radius:12rpx;font-size:25rpx;font-weight:800}.reminder-type-icon.blue{color:#0b4aa2;background:#eaf3ff}.reminder-type-icon.orange{color:#c87300;background:#fff4df}.reminder-type-icon.green{color:#16845b;background:#e9f8f1}.state{flex:0 0 auto;margin-left:10rpx;padding:6rpx 10rpx;color:#9a6716;font-size:19rpx;border:1rpx solid #d7a34b;border-radius:6rpx}.state.on{color:#16845b;border-color:#51ad87;background:#effaf5}
.reminder-rule{display:grid;align-items:start;margin-top:20rpx;padding-top:18rpx;border-top:1rpx solid #e8eef5;grid-template-columns:118rpx 1fr;column-gap:12rpx}.reminder-rule text{font-size:21rpx;font-weight:650}.reminder-rule label{color:#667689;font-size:20rpx;line-height:1.45}.reminder-mode{margin-top:18rpx;padding:14rpx 16rpx;color:#98610b;font-size:19rpx;line-height:1.45;border-radius:8rpx;background:#fff7e8}.reminder-card button{width:100%;min-height:76rpx;margin-top:20rpx;border-radius:8rpx;font-size:24rpx;font-weight:650}.reminder-card button.primary{color:#fff;background:#0b4aa2}.reminder-card button.secondary{color:#0b4aa2;border:1rpx solid #0b4aa2;background:#fff}
.schedule-row{display:grid;margin-top:20rpx;grid-template-columns:1fr 1fr;gap:12rpx}.schedule-row picker view{padding:18rpx;color:#0b4aa2;font-size:22rpx;text-align:center;border:1rpx solid #b9cbe1;border-radius:8rpx;background:#f8fbff}.contractor-steps{display:flex;align-items:flex-start;justify-content:space-between;margin-top:22rpx;padding:18rpx 8rpx;border-radius:10rpx;background:#f7faff}.contractor-steps>view{flex:1;text-align:center}.contractor-steps>view text{display:flex;width:42rpx;height:42rpx;align-items:center;justify-content:center;margin:auto;color:#fff;border-radius:50%;background:#0b4aa2}.contractor-steps>view label{display:block;margin-top:8rpx;color:#647387;font-size:17rpx;line-height:1.35}.contractor-steps>text{padding-top:9rpx;color:#83a4ca}
.reminder-footnote{margin-top:22rpx;padding:20rpx}.reminder-footnote text,.reminder-footnote label{display:block}.reminder-footnote text{font-size:22rpx;font-weight:700}.reminder-footnote label{margin-top:8rpx;color:#778496;font-size:19rpx;line-height:1.55}
@media (max-width:360px){.reminder-screen{padding-right:16rpx;padding-left:16rpx}.reminder-card{padding:18rpx}.reminder-card-head label{font-size:18rpx}.state{max-width:92rpx}.contractor-steps>view label{font-size:16rpx}}

/* Ant-style settings cards and semantic states. */
.reminder-screen{color:var(--text);background:var(--bg)}.reminder-context,.reminder-card,.reminder-footnote,.reminder-overview-card{border-color:var(--line-soft);border-radius:24rpx;box-shadow:var(--shadow-sm)}
.reminder-intro text{font-weight:700}.reminder-type-icon{border-radius:16rpx}.reminder-type-icon.blue{color:#1677ff;background:#e6f4ff}.state{border:0;border-radius:999rpx;background:#fff7e6}.state.on{color:#389e0d;background:#f6ffed}
.reminder-mode{border-radius:14rpx;background:#fff7e6}.reminder-card button,.schedule-row picker view{border-radius:16rpx}.reminder-card button.primary{background:#1677ff}.reminder-card button.secondary{color:#1677ff;border-color:#91caff}.contractor-steps{border-radius:18rpx;background:#fafafa}.contractor-steps>view text{background:#1677ff}
