.today-screen{padding:0 24rpx calc(40rpx + env(safe-area-inset-bottom));background:var(--bg)}
.today-screen>.shared-brand-bar{margin-right:-24rpx;margin-left:-24rpx}
.today-head{display:flex;min-height:116rpx;align-items:center;justify-content:space-between}.today-head>view text,.today-head>view label{display:block}.today-head>view text{font-size:38rpx;font-weight:700}.today-head>view label{margin-top:2rpx;color:var(--text-3);font-size:20rpx}.today-head button{min-height:60rpx;padding:0 18rpx;color:var(--blue);font-size:21rpx;background:#fff;border:1rpx solid #91caff;border-radius:999rpx}
.today-summary{padding:26rpx;border:0;border-radius:24rpx;background:#fff;box-shadow:var(--shadow-sm)}.today-summary>view{display:flex;align-items:baseline}.today-summary>view>label{font-size:25rpx;font-weight:600}.today-summary>view>text{margin-left:14rpx;color:#ff4d4f;font-size:44rpx;font-weight:700}.today-summary .today-unit{display:inline;margin-left:4rpx;color:var(--text-2);font-size:20rpx}.today-summary>label{display:block;margin-top:6rpx;color:var(--text-3);font-size:19rpx}
.reminder-group{margin-top:28rpx}.reminder-title{display:block;margin:0 4rpx 12rpx;font-size:25rpx;font-weight:600}.warning-group .reminder-title,.urge-group .reminder-title{color:#d46b08}
.reminder-row{display:flex;min-height:112rpx;align-items:center;margin-left:0;padding:18rpx 22rpx;border:0;border-bottom:1rpx solid var(--line-soft);background:#fff}.reminder-row:first-of-type{border-radius:24rpx 24rpx 0 0}.reminder-row:last-child{border-bottom:0;border-radius:0 0 24rpx 24rpx}.reminder-row:only-of-type{border-radius:24rpx}.reminder-row+.reminder-row{border-top:0}.reminder-row-press{background:#f5faff}
.reminder-icon{display:flex;flex:0 0 60rpx;width:60rpx;height:60rpx;align-items:center;justify-content:center;margin-right:18rpx;color:#1677ff;font-size:19rpx;font-weight:700;border:0;border-radius:16rpx;background:#e6f4ff}.warning-group .reminder-icon,.urge-group .reminder-icon{color:#d46b08;background:#fff7e6}
.reminder-copy{flex:1;min-width:0}.reminder-copy text,.reminder-copy label{display:block;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.reminder-copy text{font-size:25rpx;font-weight:600}.reminder-copy label{margin-top:5rpx;color:var(--text-3);font-size:19rpx}.reminder-arrow{flex:0 0 auto;margin-left:12rpx;color:#bfbfbf;font-size:36rpx}
.today-empty{display:flex;min-height:430rpx;flex-direction:column;align-items:center;justify-content:center;color:#52c41a}.today-empty text{display:flex;width:88rpx;height:88rpx;align-items:center;justify-content:center;font-size:46rpx;border-radius:50%;background:#f6ffed}.today-empty label{margin-top:20rpx;color:var(--text-2);font-size:23rpx}.today-note{display:block;margin-top:34rpx;color:var(--text-3);font-size:18rpx;text-align:center}
