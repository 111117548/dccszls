.today-screen{padding:0 26rpx calc(36rpx + env(safe-area-inset-bottom));background:#f4f7fb}
.today-screen>.shared-brand-bar{margin-right:-26rpx;margin-left:-26rpx}
.today-head{display:flex;height:88rpx;align-items:center;justify-content:space-between}.today-head>text{font-size:27rpx;font-weight:700}.today-head button{min-height:56rpx;padding:0 12rpx;color:#0b4aa2;font-size:22rpx;background:transparent}
.today-summary{padding:24rpx;border:1rpx solid #d6e0eb;border-radius:14rpx;background:#fff;box-shadow:0 8rpx 24rpx rgba(23,50,78,.05)}.today-summary>view{display:flex;align-items:baseline}.today-summary>view>label{font-size:26rpx;font-weight:700}.today-summary>view>text{margin-left:14rpx;color:#d7393f;font-size:42rpx;font-weight:800}.today-summary .today-unit{display:inline;margin-left:4rpx;color:#172437;font-size:20rpx}.today-summary>label{display:block;margin-top:5rpx;color:#8793a2;font-size:19rpx}
.reminder-group{margin-top:28rpx}.reminder-title{display:block;margin-bottom:12rpx;padding-left:18rpx;font-size:25rpx;font-weight:800;border-left:7rpx solid #0b4aa2}.warning-group .reminder-title,.urge-group .reminder-title{border-left-color:#e06b13}
.reminder-row{display:flex;min-height:104rpx;align-items:center;padding:16rpx 18rpx;border:1rpx solid #d6e0eb;background:#fff}.reminder-row:first-of-type{border-radius:12rpx 12rpx 0 0}.reminder-row:last-child{border-radius:0 0 12rpx 12rpx}.reminder-row:only-of-type{border-radius:12rpx}.reminder-row+.reminder-row{border-top:0}.reminder-row-press{background:#f2f7fd}
.reminder-icon{display:flex;flex:0 0 54rpx;width:54rpx;height:54rpx;align-items:center;justify-content:center;margin-right:16rpx;color:#0b4aa2;font-size:19rpx;font-weight:800;border:2rpx solid currentColor;border-radius:50%}.warning-group .reminder-icon,.urge-group .reminder-icon{color:#e06b13}
.reminder-copy{flex:1;min-width:0}.reminder-copy text,.reminder-copy label{display:block;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.reminder-copy text{font-size:24rpx;font-weight:700}.reminder-copy label{margin-top:4rpx;color:#6b7889;font-size:18rpx}.reminder-arrow{flex:0 0 auto;margin-left:12rpx;color:#5d6b7c;font-size:34rpx}
.today-empty{display:flex;min-height:430rpx;flex-direction:column;align-items:center;justify-content:center;color:#16845b}.today-empty text{display:flex;width:84rpx;height:84rpx;align-items:center;justify-content:center;font-size:46rpx;border:2rpx solid currentColor;border-radius:50%}.today-empty label{margin-top:20rpx;color:#5d6b7c;font-size:23rpx}.today-note{display:block;margin-top:34rpx;color:#9aa5b2;font-size:18rpx;text-align:center}
