<view class="screen coming-soon-screen">
  <view class="shared-brand-bar">
    <image src="/images/brand/zijin-longking-horizontal.png" mode="aspectFit" aria-label="紫金龙净"></image>
    <view><text>工程质量数字化平台</text><label>ENGINEERING QUALITY</label></view>
  </view>
  <view class="coming-soon-card">
    <view class="feature-icon"><image src="{{icon}}" mode="aspectFit" aria-label="{{featureName}}"></image></view>
    <text class="feature-name">{{featureName}}</text>
    <text class="feature-message">正在开发中，敬请期待</text>
    <button class="back-button" bindtap="backToWorkbench">返回工作台</button>
  </view>
</view>
