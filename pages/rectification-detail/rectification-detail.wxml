<view class="screen rectification-screen">
  <view class="loading-box" wx:if="{{loading}}"><text>正在读取整改任务…</text></view>
  <view class="loading-box error" wx:elif="{{errorMessage}}"><text>整改任务无法打开</text><label>{{errorMessage}}</label></view>

  <block wx:elif="{{order}}">
    <view class="rect-head"><text class="back">‹</text><text>{{isReview || isClosed ? '整改复验' : '整改任务'}}</text><label class="status status-{{order.status}}">{{displayStatus}}</label></view>

    <view class="flow-steps" wx:if="{{isReview || isClosed}}">
      <view class="done"><text>✓</text><label>发现缺陷</label></view><view class="flow-line done"></view>
      <view class="done"><text>✓</text><label>整改提交</label></view><view class="flow-line done"></view>
      <view class="{{isClosed ? 'done' : 'current'}}"><text>{{isClosed ? '✓' : '3'}}</text><label>复验</label></view><view class="flow-line {{isClosed ? 'done' : ''}}"></view>
      <view class="{{isClosed ? 'done' : ''}}"><text>{{isClosed ? '✓' : '4'}}</text><label>闭环</label></view>
    </view>

    <view class="defect-summary panel">
      <view class="summary-copy">
        <text>{{order.primaryItem.name || order.title}}</text>
        <label class="level">{{order.primaryItem.severityName}}</label>
        <label>{{order.positionCode || order.primaryItem.positionCode}}</label>
        <view><text>整改期限</text><label>{{order.deadlineText}}</label></view>
      </view>
      <image wx:if="{{order.sourceImageUrl && !isReview && !isClosed}}" src="{{order.sourceImageUrl}}" mode="aspectFill" bindtap="previewSource"></image>
    </view>

    <view class="open-mode" wx:if="{{fromShare && !isClosed && !isReview}}">ⓘ　无需绑定项目身份，收到分享即可提交整改</view>
    <view class="open-mode" wx:if="{{isCreatorView && !canManageProject}}">ⓘ　当前项目仅可查看，不能分享、复验或回传整改资料</view>

    <view class="simple-flow" wx:if="{{!isClosed && !isReview}}">
      <view class="active"><text>➤</text><label>整改单已发送</label></view><view class="dashed"></view><view><text>◷</text><label>等待整改提交</label></view>
    </view>

    <view class="reminder-card" wx:if="{{fromShare && canOperate}}">
      <view><text>整改微信提醒</text><label>{{reminderStatusText}}</label><picker wx:if="{{!reminderEnabled}}" mode="time" value="{{reminderSendTime}}" bindchange="onReminderTimeChange"><view class="reminder-time-picker">每天 {{reminderSendTime}} 检查提醒　⌄</view></picker></view>
      <button wx:if="{{!reminderEnabled}}" bindtap="enableReminder" loading="{{reminderLoading}}">{{reminderNeedsRenewal ? '续订提醒' : '开启提醒'}}</button>
      <button wx:else bindtap="disableReminder" loading="{{reminderLoading}}">关闭提醒</button>
    </view>

    <view class="evidence-form panel" wx:if="{{canOperate}}">
      <text class="form-title">整改情况说明 <label>*</label></text>
      <textarea value="{{rectificationNote}}" bindinput="onNoteInput" placeholder="填写已采取的整改措施" maxlength="200"></textarea>
      <view class="counter">{{rectificationNote.length || 0}}/200</view>
      <text class="form-title">整改后照片 <label>*</label></text>
      <view class="photo-grid">
        <view class="photo-item" wx:for="{{localPhotos}}" wx:key="*this"><image src="{{item}}" mode="aspectFill" bindtap="previewPhoto" data-url="{{item}}"></image><button catchtap="removeEvidence" data-index="{{index}}">×</button></view>
        <button class="photo-add" wx:if="{{localPhotos.length < 9}}" bindtap="chooseEvidence"><text>＋</text><label>继续上传</label></button>
      </view>
      <text class="form-title optional">复测值（选填）</text><input class="measure-input" value="{{measurement}}" bindinput="onMeasurementInput" placeholder="例如：平面度偏差 3mm" />
      <view class="closure-error" wx:if="{{closureError}}">{{closureError}}</view>
    </view>
    <view class="rect-actions" wx:if="{{canOperate || (canManageProject && !isClosed && !isReview)}}">
      <button class="share-task" bindtap="openSharePreview" wx:if="{{canManageProject && !isClosed && !isReview}}"><text>分享任务</text></button>
      <button class="submit-rectification" wx:if="{{canOperate}}" bindtap="submitClosure" loading="{{submitting}}"><text>提交整改</text></button>
    </view>

    <view class="review-card panel" wx:if="{{isReview || isClosed}}">
      <view class="review-section-head">
        <view><text>整改证据</text><label>现场整改前后对比</label></view>
        <label class="evidence-count">{{order.afterPhotos.length}} 张整改照片</label>
      </view>
      <view class="review-meta">
        <view><text>缺陷部位</text><label>{{order.primaryItem.systemName || order.deviceName || '未填写'}} · {{order.positionCode || order.primaryItem.positionCode || '未填写'}}</label></view>
        <view><text>整改状态</text><label class="state-{{order.status}}">{{displayStatus}}</label></view>
      </view>
      <view class="compare">
        <view>
          <text class="before">整改前</text>
          <image wx:if="{{order.beforePhotos.length}}" src="{{order.beforePhotos[0]}}" mode="aspectFill" bindtap="previewPhoto" data-url="{{order.beforePhotos[0]}}" data-group="before"></image>
          <view class="photo-empty" wx:else><text>暂无整改前照片</text></view>
        </view>
        <view>
          <text class="after">整改后</text>
          <image wx:if="{{order.afterPhotos.length}}" src="{{order.afterPhotos[0]}}" mode="aspectFill" bindtap="previewPhoto" data-url="{{order.afterPhotos[0]}}" data-group="after"></image>
          <view class="photo-empty" wx:else><text>暂无整改后照片</text></view>
        </view>
      </view>
      <view class="after-gallery" wx:if="{{order.afterPhotos.length > 1}}">
        <view class="gallery-head"><text>全部整改后照片</text><label>{{order.afterPhotos.length}} 张</label></view>
        <scroll-view scroll-x="true" class="gallery-scroll">
          <view class="gallery-list">
            <image wx:for="{{order.afterPhotos}}" wx:key="*this" src="{{item}}" mode="aspectFill" bindtap="previewPhoto" data-url="{{item}}" data-group="after"></image>
          </view>
        </scroll-view>
      </view>
      <view class="rect-note"><text>整改说明</text><label>{{order.rectificationNote || '未填写整改说明'}}</label></view>
      <view class="timeline-section" wx:if="{{order.timeline.length}}">
        <text class="timeline-title">闭环记录</text>
        <view class="audit-timeline">
          <view wx:for="{{order.timeline}}" wx:key="time" class="{{index === order.timeline.length - 1 && !isClosed ? 'current' : 'done'}}"><text>{{index === order.timeline.length - 1 && !isClosed ? '◷' : '✓'}}</text><label>{{item.name}}</label><text class="timeline-time">{{item.time}}</text></view>
        </view>
      </view>
      <view class="feishu-closure-note" wx:if="{{isExternalClosing && order.feishuClosureSyncState === 'synced'}}">✓ 整改说明及照片已回传飞书，等待相关部门在飞书完成最终闭环。</view>
      <view class="feishu-closure-note" wx:if="{{isExternalClosing && order.feishuClosureSyncState === 'verifying'}}">◌ 云函数回执超时，正在核验飞书中的整改附件，请勿重复提交。</view>
      <view class="feishu-closure-note error" wx:if="{{isExternalClosing && order.feishuClosureSyncState === 'failed'}}">飞书回传失败：{{order.feishuClosureSyncError}}<button wx:if="{{canManageProject}}" bindtap="retryFeishuSync" loading="{{reviewing}}">重新回传飞书</button></view>
      <view class="feishu-closure-note" wx:if="{{order.feishuRecordId && isReview && !isExternalClosing}}">整改证据已保存，复验通过后将自动回传飞书“闭环”附件列。</view>
      <block wx:if="{{canManageProject && isReview && !isExternalClosing}}">
        <text class="form-title optional">复验意见</text>
        <textarea class="review-input" value="{{reviewNote}}" bindinput="onReviewNoteInput" placeholder="请输入复验意见（选填）" maxlength="200"></textarea>
        <view class="review-actions"><button class="danger-btn" bindtap="rejectReview" loading="{{reviewing}}">退回整改</button><button class="success-btn" bindtap="acceptReview" loading="{{reviewing}}">通过并闭环</button></view>
      </block>
      <view class="closed-result" wx:if="{{isClosed && !order.feishuRecordId}}">✓　该缺陷已完成整改闭环</view>
      <view class="closed-result" wx:if="{{isClosed && order.feishuRecordId && order.feishuStatus === 'closed'}}">✓ 飞书已确认该缺陷完成整改闭环</view>
      <view class="closed-result" wx:if="{{isClosed && order.feishuRecordId && order.feishuStatus !== 'closed' && order.feishuClosureSyncState === 'synced'}}">✓ 整改证据已回传飞书，等待相关部门在飞书完成最终闭环</view>
    </view>

    <button class="reopen-task" wx:if="{{isClosed && canManageProject}}" bindtap="reopenOrder">重新打开整改</button>
  </block>
</view>
