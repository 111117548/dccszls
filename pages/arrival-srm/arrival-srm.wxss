.arrival-screen{padding-top:20rpx;padding-bottom:70rpx}.arrival-overview-card{margin-top:0}.overview-eyebrow{display:block;margin-bottom:6rpx;color:var(--brand);font-size:20rpx;font-weight:600}.overview-rate-box{flex:none;text-align:right}.overview-rate-box label{display:block;margin-top:2rpx;color:var(--text-3);font-size:19rpx}.overview-empty-tip{margin-top:22rpx;padding:20rpx 22rpx;color:var(--text-2);font-size:21rpx;line-height:1.6;border-radius:14rpx;background:var(--panel-soft)}
.processing-card{display:flex;align-items:center;margin:0 28rpx 20rpx;padding:22rpx 24rpx;color:var(--brand);border:1rpx solid #bed2ec;border-radius:16rpx;background:var(--brand-soft)}.processing-dot{width:16rpx;height:16rpx;margin-right:16rpx;border-radius:50%;background:var(--brand);box-shadow:0 0 0 8rpx rgba(11,74,162,.1)}
.panel-heading,.overview-head,.stage-copy{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.panel-title{display:block;color:var(--text);font-size:30rpx;font-weight:700}.panel-copy{display:block;margin-top:4rpx;color:var(--text-3);font-size:22rpx}.status-tag{flex:none;padding:5rpx 14rpx;color:var(--warning);font-size:21rpx;border:1rpx solid #e8c983;border-radius:8rpx;background:var(--warning-soft)}.status-tag.ready{color:var(--success);border-color:#a9d8c6;background:var(--success-soft)}
.file-card{display:flex;align-items:center;margin-top:22rpx;padding:20rpx;border:1rpx solid var(--line-soft);border-radius:12rpx;background:var(--panel-soft)}.file-icon{display:flex;flex:none;align-items:center;justify-content:center;width:72rpx;height:72rpx;color:#fff;font-size:20rpx;font-weight:700;border-radius:10rpx;background:var(--success)}.file-main{min-width:0;margin-left:18rpx}.file-name,.file-meta{display:block}.file-name{overflow:hidden;color:var(--text);font-weight:600;white-space:nowrap;text-overflow:ellipsis}.file-meta{margin-top:4rpx;color:var(--text-3);font-size:21rpx}
.demand-button{width:100%;margin-top:24rpx}.import-help{display:flex;align-items:flex-start;gap:10rpx;margin-top:16rpx;color:var(--text-3);font-size:20rpx;line-height:1.5}.import-help-icon{display:flex;flex:0 0 auto;align-items:center;justify-content:center;width:28rpx;height:28rpx;margin-top:1rpx;color:#fff;font-size:18rpx;line-height:28rpx;border-radius:50%;background:#879bb3}.import-help>text:last-child{flex:1;min-width:0}.permission-note{display:block;margin-top:14rpx;color:var(--danger);font-size:22rpx}
.rate-number{color:var(--brand);font-size:46rpx;font-weight:800}.progress-track,.mini-track{overflow:hidden;background:#e5ecf4;border-radius:999rpx}.progress-track{height:16rpx;margin-top:24rpx}.progress-fill,.mini-fill{height:100%;border-radius:999rpx;background:linear-gradient(90deg,var(--brand),var(--brand-2))}
.kpi-row{display:grid;grid-template-columns:repeat(4,1fr);margin-top:26rpx}.kpi-row view{text-align:center;border-right:1rpx solid var(--line-soft)}.kpi-row view:last-child{border-right:0}.kpi-row text,.kpi-row label{display:block}.kpi-row text{color:var(--text-3);font-size:21rpx}.kpi-row label{margin-top:5rpx;color:var(--text);font-size:38rpx;font-weight:700}.kpi-row .kpi-unit{color:var(--text-3);font-size:18rpx}.kpi-row .success-number{color:var(--success)}.kpi-row .warning-number{color:var(--warning)}
.section-heading-out{display:flex;align-items:flex-end;justify-content:space-between;margin:28rpx 30rpx 14rpx}.section-heading-out text{font-size:30rpx;font-weight:700}.section-heading-out label{color:var(--text-3);font-size:20rpx}.stage-panel{padding:0 24rpx}.stage-row{display:flex;align-items:center;min-height:112rpx;border-bottom:1rpx solid var(--line-soft)}.stage-row:last-child{border-bottom:0}.stage-index{display:flex;flex:none;align-items:center;justify-content:center;width:54rpx;height:54rpx;color:var(--brand);font-size:22rpx;font-weight:700;border:1rpx solid #b8cce6;border-radius:10rpx;background:var(--brand-soft)}.stage-main{flex:1;min-width:0;margin-left:18rpx}.stage-copy text{overflow:hidden;font-weight:600;white-space:nowrap;text-overflow:ellipsis}.stage-copy label{flex:none;color:var(--text-3);font-size:21rpx}.mini-track{height:8rpx;margin-top:12rpx}.stage-tail{flex:0 0 90rpx;text-align:right}.stage-tail text,.stage-tail label{display:block}.stage-tail .stage-rate{color:var(--brand);font-size:23rpx;font-weight:700}.stage-tail label{margin-top:5rpx;color:var(--text-3);font-size:18rpx}
.empty-card{margin:38rpx 28rpx;padding:70rpx 44rpx;text-align:center;border:1rpx dashed #b9c9dc;border-radius:18rpx;background:#fff}.empty-icon{color:var(--brand);font-size:70rpx}.empty-title,.empty-copy{display:block}.empty-title{margin-top:16rpx;font-size:30rpx;font-weight:700}.empty-copy{margin-top:10rpx;color:var(--text-2);font-size:23rpx;line-height:1.7}
.import-history-panel{padding:0 24rpx}.import-history-row{display:flex;align-items:center;justify-content:space-between;gap:24rpx;min-height:104rpx;padding:16rpx 0;border-bottom:1rpx solid var(--line-soft)}.import-history-row:last-child{border-bottom:0}.import-history-row>view{min-width:0}.import-history-row>view:first-child{flex:1}.import-history-row>view:last-child{flex:none;text-align:right}.import-history-row text,.import-history-row label{display:block}.import-history-row>view:first-child text{overflow:hidden;font-size:23rpx;font-weight:600;white-space:nowrap;text-overflow:ellipsis}.import-history-row>view:last-child text{color:var(--success);font-size:21rpx;font-weight:600}.import-history-row label{margin-top:5rpx;color:var(--text-3);font-size:18rpx}
