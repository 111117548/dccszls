.manage-page{min-height:100vh;padding:28rpx 28rpx 70rpx;background:linear-gradient(#020c17,#061625);color:#fff}.page-head,.section-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:22rpx}.page-head>view text,.section-head>view text{display:block;color:var(--blue);font-size:18rpx;letter-spacing:2rpx}.page-head>view label,.section-head>view label{display:block;margin-top:5rpx;font-size:34rpx;font-weight:800}.page-head button,.section-head button{min-height:64rpx;padding:0 18rpx;color:var(--blue);line-height:64rpx;background:transparent;border:1rpx solid var(--blue)}
.project-list,.device-list{display:flex;flex-direction:column;gap:14rpx}.project-card,.device-card{padding:22rpx;border:1rpx solid var(--line);border-radius:8rpx;background:linear-gradient(145deg,rgba(10,30,47,.94),rgba(4,18,30,.9))}.project-card.active,.device-card.active{border-color:var(--yellow)}.project-top,.device-card{display:flex;align-items:center;justify-content:space-between}.master-copy text{display:block;font-size:28rpx;font-weight:700}.master-copy label{display:block;margin-top:6rpx;color:var(--text-2);font-size:20rpx}.status{padding:6rpx 12rpx;color:var(--green);border:1rpx solid currentColor}.status-completed{color:var(--blue)}.status-archived{color:var(--text-3)}.project-meta{display:flex;justify-content:space-between;margin:18rpx 0;color:var(--text-2);font-size:21rpx}.project-card>button,.device-actions button{min-height:60rpx;padding:0 18rpx;color:var(--blue);line-height:60rpx;background:transparent;border:1rpx solid var(--line)}.device-actions{display:flex;gap:10rpx}.device-actions .danger{color:var(--red);border-color:var(--red)}.section-head{margin-top:42rpx}.empty{padding:60rpx;text-align:center;color:var(--text-3);border:1rpx dashed var(--line)}
.master-icon{display:block;flex:0 0 58rpx;width:58rpx;height:58rpx;margin-right:16rpx}.master-copy{flex:1;min-width:0}
.modal-mask{position:fixed;z-index:80;inset:0;background:rgba(0,6,12,.8)}.form-panel{position:fixed;z-index:81;left:24rpx;right:24rpx;bottom:0;max-height:88vh;padding:24rpx 28rpx calc(36rpx + env(safe-area-inset-bottom));overflow:auto;border:1rpx solid var(--line);border-radius:30rpx 30rpx 0 0;background:linear-gradient(150deg,#10263a,#071727)}.form-head{display:flex;align-items:center;justify-content:space-between}.form-head text{font-size:34rpx;font-weight:800}.form-head button{width:60rpx;min-height:60rpx;padding:0;color:var(--text-2);line-height:60rpx;background:transparent}.form-panel>label{display:block;margin:18rpx 0 8rpx;color:var(--text-2)}.form-panel input,.picker{min-height:78rpx;padding:0 18rpx;line-height:78rpx;border:1rpx solid var(--line);background:rgba(3,14,24,.78)}.form-panel .save{width:100%;margin-top:26rpx;color:#fff;background:linear-gradient(135deg,#0878ed,#1267ca);border:1rpx solid #2f9cff}

/* V6 企业协同明亮主题 */
.manage-page{background:var(--bg);color:var(--text)}
.page-head>view text,.section-head>view text{color:var(--brand)}
.page-head>view label,.section-head>view label{color:var(--text)}
.page-head button,.section-head button{color:var(--brand);background:#fff;border-color:var(--line)}
.project-card,.device-card{background:#fff;border-color:var(--line);box-shadow:var(--shadow-sm)}
.project-card.active,.device-card.active{border-color:var(--brand);box-shadow:0 0 0 2rpx rgba(11,74,162,.08)}
.master-copy text{max-width:470rpx;overflow:hidden;color:var(--text);white-space:nowrap;text-overflow:ellipsis}
.master-copy label,.project-meta{color:var(--text-2)}
.status{color:var(--success);background:var(--success-soft)}
.status-completed{color:var(--brand);background:var(--brand-soft)}
.status-archived{color:var(--text-3);background:#f1f3f5}
.project-card>button,.device-actions button{min-width:0;color:var(--brand);background:#fff;border-color:var(--line);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.empty{color:var(--text-3);background:#fff;border-color:var(--line)}
.modal-mask{background:rgba(15,35,58,.45)}
.form-panel{color:var(--text);background:#fff;border-color:var(--line);box-shadow:0 -18rpx 60rpx rgba(15,35,58,.14)}
.form-head text{color:var(--text)}
.form-head button{color:var(--text-2)}
.form-panel>label{color:var(--text-2)}

/* 覆盖旧版用 line-height 模拟居中的写法。 */
.page-head button,.section-head button,.project-card>button,.device-actions button,.form-head button,.form-panel .save{
  display:flex;
  align-items:center;
  justify-content:center;
  line-height:1.2;
  white-space:nowrap;
}
.form-panel input,.picker{color:var(--text);background:#fff;border-color:var(--line)}
.form-panel .save{background:linear-gradient(135deg,var(--brand),var(--brand-2));border-color:var(--brand)}
.permission-note { margin: 16rpx 24rpx; padding: 16rpx 20rpx; font-size: 22rpx; border: 1rpx solid; border-radius: 8rpx; }
.permission-note.editable { color: #087f5b; background: #edf9f4; border-color: #9bd3be; }
.permission-note.readonly { color: #815c18; background: #fff8e6; border-color: #ead49d; }

/* V7 responsive cards and bottom forms */
.page-head,.section-head{gap:18rpx;align-items:flex-start}
.page-head>view,.section-head>view{flex:1;min-width:0}
.page-head>view text,.page-head>view label,.section-head>view text,.section-head>view label{max-width:100%;overflow:hidden;text-overflow:ellipsis}
.page-head>view label,.section-head>view label{white-space:normal;line-height:1.3}
.page-head button,.section-head button{flex:0 0 auto;max-width:190rpx;padding:10rpx 18rpx;line-height:1.2;white-space:normal}
.project-top{gap:16rpx;align-items:flex-start}
.project-top>view.master-copy{flex:1;min-width:0}
.master-copy text{max-width:100%}
.status{flex:0 0 auto;max-width:180rpx;overflow:hidden;font-size:21rpx;line-height:1.3;text-align:center;white-space:normal;text-overflow:ellipsis}
.project-meta{gap:14rpx;flex-wrap:wrap;justify-content:flex-start}
.project-meta text{min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.device-card{gap:18rpx;align-items:flex-start}
.device-card>view.master-copy{flex:1;min-width:0}
.device-card>view.master-copy text,.device-card>view.master-copy label{max-width:100%;overflow:hidden;text-overflow:ellipsis}
.device-actions{display:grid;flex:0 0 188rpx;width:188rpx;grid-template-columns:repeat(2,minmax(0,1fr));gap:10rpx}
.device-actions button{width:100%;padding:8rpx;font-size:22rpx;line-height:1.2}
.form-head{position:sticky;z-index:2;top:-24rpx;margin:-24rpx -28rpx 0;padding:24rpx 28rpx 14rpx;background:#fff;border-bottom:1rpx solid var(--line-soft)}
.form-head text{flex:1;min-width:0;padding-right:14rpx;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.form-panel .save{position:sticky;bottom:0;min-height:88rpx;padding:14rpx 20rpx;box-shadow:0 -12rpx 24rpx rgba(255,255,255,.94)}

@media (max-width:360px){
  .manage-page{padding-left:20rpx;padding-right:20rpx}
  .page-head>view label,.section-head>view label{font-size:30rpx}
  .permission-note{margin-left:0;margin-right:0}
  .device-card{flex-direction:column}
  .device-actions{width:100%;grid-template-columns:repeat(2,minmax(0,1fr))}
  .project-card,.device-card{padding:18rpx}
  .form-panel{left:12rpx;right:12rpx;padding-left:22rpx;padding-right:22rpx}
  .form-head{margin-left:-22rpx;margin-right:-22rpx;padding-left:22rpx;padding-right:22rpx}
}
