.api-screen{padding:24rpx 24rpx calc(36rpx + env(safe-area-inset-bottom));background:#f4f7fb}
.api-screen>.shared-brand-bar{margin-top:-24rpx;margin-right:-24rpx;margin-left:-24rpx}
.api-summary{display:grid;padding:22rpx 0;border:1rpx solid #d6e0eb;border-radius:14rpx;background:#fff;box-shadow:0 8rpx 24rpx rgba(23,50,78,.05);grid-template-columns:repeat(3,minmax(0,1fr))}.api-summary>view{text-align:center;border-right:1rpx solid #e8eef5}.api-summary>view:last-child{border-right:0}.api-summary label,.api-summary text{display:block}.api-summary label{color:#5d6b7c;font-size:19rpx}.api-summary text{margin-top:5rpx;color:#0b4aa2;font-size:34rpx;font-weight:800}.api-summary .green{color:#16845b}.api-summary .orange{color:#d78b00}
.api-head{display:flex;align-items:center;justify-content:space-between;margin:28rpx 4rpx 14rpx}.api-head>view{min-width:0}.api-head text,.api-head label{display:block}.api-head text{font-size:28rpx;font-weight:800}.api-head label{margin-top:3rpx;color:#8793a2;font-size:17rpx}.api-head button{flex:0 0 auto;min-height:58rpx;margin-left:14rpx;padding:0 16rpx;color:#0b4aa2;font-size:19rpx;background:#fff;border:1rpx solid #0b4aa2}
.api-list{overflow:hidden;border:1rpx solid #d6e0eb;border-radius:14rpx;background:#fff}.api-row{display:flex;min-height:102rpx;align-items:center;padding:14rpx 18rpx;border-bottom:1rpx solid #e8eef5}.api-row:last-child{border-bottom:0}.api-row-press{background:#f2f7fd}.api-icon{display:flex;flex:0 0 54rpx;width:54rpx;height:54rpx;align-items:center;justify-content:center;margin-right:14rpx;color:#0b4aa2;font-size:16rpx;font-weight:800;border:1rpx solid #b9cee6;border-radius:50%;background:#eef5ff}.api-copy{flex:1;min-width:0}.api-copy text,.api-copy label{display:block;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.api-copy text{font-size:23rpx;font-weight:700}.api-copy label{margin-top:4rpx;color:#8793a2;font-size:17rpx}.api-status{flex:0 0 auto;margin-left:10rpx;padding:4rpx 10rpx;color:#5d6b7c;font-size:17rpx;border-radius:999rpx;background:#f0f3f7}.api-status.normal{color:#16845b;background:#eef8f3}.api-status.warning{color:#b56f00;background:#fff7e7}.api-status.checking{color:#0b4aa2;background:#eef5ff}.api-arrow{margin-left:10rpx;color:#8793a2;font-size:30rpx}.api-help{width:100%;min-height:72rpx;margin-top:22rpx;color:#0b4aa2;font-size:20rpx;background:#fff;border:1rpx solid #0b4aa2}
.api-detail-sheet{padding-right:28rpx;padding-left:28rpx}.api-detail-title{display:flex;align-items:center}.api-detail-title>view:nth-child(2){flex:1;min-width:0}.api-detail-title>view:nth-child(2) text,.api-detail-title>view:nth-child(2) label{display:block}.api-detail-title>view:nth-child(2) text{font-size:29rpx;font-weight:800}.api-detail-title>view:nth-child(2) label{margin-top:4rpx;color:#8793a2;font-size:18rpx}.api-detail-card{margin-top:24rpx;padding:4rpx 20rpx;border:1rpx solid #d6e0eb;border-radius:12rpx}.api-detail-card>view{display:flex;min-height:78rpx;align-items:center;border-bottom:1rpx solid #e8eef5}.api-detail-card>view:last-child{border-bottom:0}.api-detail-card label{flex:0 0 150rpx;color:#5d6b7c;font-size:20rpx}.api-detail-card text{flex:1;min-width:0;font-size:20rpx;text-align:right;word-break:break-word}.api-test,.api-close{width:100%;margin-top:20rpx}.api-close{margin-top:12rpx}

/* Ant-style system status list. */
.api-screen{background:var(--bg)}.api-summary,.api-list{border-color:var(--line-soft);border-radius:24rpx;box-shadow:var(--shadow-sm)}.api-summary text{font-weight:700}
.api-head text{font-weight:700}.api-head button,.api-help{color:#1677ff;border-color:#91caff;border-radius:16rpx}.api-row-press{background:#f5faff}.api-icon{border:0;border-radius:16rpx;color:#1677ff;background:#e6f4ff}.api-copy text{font-weight:600}.api-status{border-radius:999rpx}.api-status.normal{color:#389e0d;background:#f6ffed}.api-status.warning{color:#d46b08;background:#fff7e6}.api-status.checking{color:#1677ff;background:#e6f4ff}.api-arrow{color:#bfbfbf}.api-detail-card{border-color:var(--line-soft);border-radius:20rpx}
