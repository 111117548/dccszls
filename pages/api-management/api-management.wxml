<view class="screen api-screen">
  <view class="shared-brand-bar"><image src="/images/brand/zijin-longking-horizontal.png" mode="aspectFit" aria-label="紫金龙净"></image><view><text>工程质量数字化平台</text><label>ENGINEERING QUALITY</label></view></view>
  <view class="api-summary">
    <view><label>接口</label><text>{{summary.total}}</text></view><view><label>正常</label><text class="green">{{summary.normal}}</text></view><view><label>需检查</label><text class="orange">{{summary.warning}}</text></view>
  </view>
  <view class="api-head"><view><text>系统接口</text><label>密钥和环境参数仅保存在云端</label></view><button bindtap="refreshAll" loading="{{checking}}">刷新状态</button></view>
  <view class="api-list">
    <view wx:for="{{services}}" wx:key="id" class="api-row" data-index="{{index}}" bindtap="openService" hover-class="api-row-press">
      <view class="api-icon">{{item.icon}}</view><view class="api-copy"><text>{{item.name}}</text><label>{{item.lastText}}</label></view><text class="api-status {{item.status}}">{{item.statusText}}</text><text class="api-arrow">›</text>
    </view>
  </view>
  <button class="api-help" bindtap="showConfigHelp">{{isAdmin ? '查看安全配置说明' : '查看管理员配置说明'}}</button>

  <view wx:if="{{showDetail}}" class="sheet-mask" bindtap="closeDetail"></view>
  <view wx:if="{{showDetail}}" class="bottom-sheet api-detail-sheet">
    <view class="sheet-handle"></view>
    <view class="api-detail-title"><view class="api-icon">{{selectedService.icon}}</view><view><text>{{selectedService.name}}</text><label>{{selectedService.purpose}}</label></view><text class="api-status {{selectedService.status}}">{{selectedService.statusText}}</text></view>
    <view class="api-detail-card"><view><label>运行环境</label><text>{{selectedService.environment}}</text></view><view><label>接口用途</label><text>{{selectedService.purpose}}</text></view><view><label>安全配置</label><text>{{selectedService.secretText}}</text></view><view><label>最近状态</label><text>{{selectedService.lastText}}</text></view></view>
    <button class="primary-btn api-test" bindtap="testSelected">测试连接</button>
    <button class="outline-btn api-close" bindtap="closeDetail">关闭</button>
  </view>
</view>
