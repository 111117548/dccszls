/* 方案C */
page{background:#14191c;color:#f4f7f8}.detail-page{background:linear-gradient(180deg,#1b2225,#111618);padding:24rpx}.asset-head{background:#252d30;border:2rpx solid #727e83;border-left:7rpx solid #ffc229}.asset-code{color:#ffc229;font-size:19rpx;font-weight:700}.asset-name{font-size:33rpx}.asset-head label{color:#c0c8cb;font-size:19rpx}.health{border-left-color:#68747a}.health text{color:#ffc229}.state{color:#68e378;border:2rpx solid #68e378;font-size:18rpx}.state-danger{color:#ff6258;border-color:#ff6258}.state-warning{color:#ffc229;border-color:#ffc229}.panel{background:#20272a;border:1rpx solid #657177}.panel-title{height:70rpx;color:#ffc229;border-bottom-color:#59656a;font-size:19rpx;font-weight:700}.panel-title label{color:#c0c8cb;font-size:18rpx}.metrics view{padding:38rpx 8rpx;border-right-color:#4f595e}.metrics text{color:#fff;font-size:37rpx}.metrics text.alarm{color:#ffc229}.metrics label{color:#b1bbbf;font-size:18rpx}.industrial-btn{height:76rpx;line-height:76rpx;color:#111619;background:#ffc229;font-size:22rpx;font-weight:700}.table-head{color:#d5dbdd;background:#30383b;font-size:18rpx}.table-row{color:#f0f3f4;border-bottom-color:#4d575c;font-size:20rpx}.mono{color:#20c7c5}.severity-major{color:#ff6258}.severity-moderate{color:#ffc229}.record{min-height:88rpx;border-bottom-color:#4e585d;font-size:20rpx}.record>text:first-child{color:#20c7c5}.record view label{color:#aeb8bc;font-size:18rpx}.empty{color:#abb5b9}.photo-item{background:#252d30;border-color:#667278}.photo-item text{color:#ffc229}.photo-item label{color:#c0c8cb}
.detail-page{padding:24rpx;background:linear-gradient(180deg,#171e21,#101517)}.asset-head{flex-wrap:wrap;gap:18rpx;padding:28rpx;background:var(--color-neutral-850);border-color:var(--border-strong)}.asset-name{font-size:36rpx}.asset-head label{font-size:21rpx}.health{width:92rpx}.state{margin-left:auto;font-size:21rpx}
.detail-grid{display:flex;flex-direction:column;margin-top:24rpx}.panel,.detail-grid .panel{background:var(--color-neutral-850);border:2rpx solid var(--border-default);border-radius:var(--radius-sm)}.detail-grid .panel{width:100%;margin:0 0 24rpx}.detail-page>.panel{width:100%;margin:24rpx 0 0}.panel-title{min-height:76rpx;height:auto;padding:14rpx 18rpx;font-size:20rpx}.panel-title text{font-size:26rpx;font-weight:700;letter-spacing:1rpx}.panel-title label{font-size:17rpx;letter-spacing:1rpx}.tree-panel{max-height:620rpx}
.metrics{display:flex}.metrics view{flex:1;min-width:0;padding:28rpx 6rpx}.metrics text{font-size:38rpx}.metrics label{font-size:20rpx;line-height:1.4}.industrial-btn{display:flex;align-items:center;justify-content:center;width:auto;min-height:88rpx;margin:20rpx;padding:0 20rpx;color:#fff;font-size:26rpx;line-height:1.2;text-align:center;white-space:nowrap;background:linear-gradient(135deg,#1978dd,#1051af);border:1rpx solid var(--blue)}
.table-head,.table-row{display:flex;align-items:center;min-height:88rpx;gap:12rpx;padding:0 18rpx}.table-head>text:nth-child(1),.table-row>text:nth-child(1){width:32%}.table-head>text:nth-child(3),.table-row>text:nth-child(3){flex:1}.table-head>text:nth-child(2),.table-head>text:nth-child(4),.table-head>text:nth-child(5),.table-row>text:nth-child(2),.table-row>text:nth-child(4),.table-row>text:nth-child(5){display:none}.table-row{font-size:23rpx}.record-press{background:#2b3539}
.record{display:flex;align-items:center;gap:14rpx;min-height:96rpx;font-size:22rpx}.record>text:first-child{width:29%}.record>view{flex:1}.record>text:nth-child(3){width:18%}.record>text:nth-child(4){display:none}.photo-item{width:250rpx}.photo-item image{width:250rpx;height:180rpx}.photo-item text,.photo-item label{font-size:21rpx}

/* V5.2 reference visual alignment */
page{background:#020d18}.detail-page{background:radial-gradient(circle at 50% 4%,rgba(45,149,255,.12),transparent 34%),linear-gradient(180deg,#010812,#020d18)}
.asset-head,.panel,.detail-grid .panel{background:rgba(7,24,39,.92);border-color:var(--line)}.asset-head{border-left-color:var(--blue)}
.asset-code,.panel-title,.record>text:first-child,.photo-item text{color:var(--blue)}.health text{color:var(--green)}
.industrial-btn{color:#fff;background:linear-gradient(135deg,#1978dd,#1051af);border:1rpx solid var(--blue)}
.table-head{background:#10263a}

/* V6 企业协同明亮主题 */
page{background:var(--bg);color:var(--text)}
.detail-page{background:var(--bg);color:var(--text)}
.asset-head,.panel,.detail-grid .panel{background:#fff;border-color:var(--line);box-shadow:var(--shadow-sm)}
.asset-head{border-left-color:var(--brand)}
.asset-code,.panel-title,.record>text:first-child,.photo-item text{color:var(--brand)}
.asset-name{max-width:430rpx;color:var(--text);overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.asset-head label,.panel-title label{color:var(--text-2)}
.health{border-left-color:var(--line)}
.health text{color:var(--success)}
.panel-title{border-bottom-color:var(--line)}
.metrics view{border-right-color:var(--line)}
.metrics text{color:var(--text)}
.metrics label{color:var(--text-2)}
.industrial-btn{background:linear-gradient(135deg,var(--brand),var(--brand-2));border-color:var(--brand)}
.table-head{color:var(--text-2);background:#eef3f8}
.table-row,.record{color:var(--text);border-bottom-color:var(--line)}
.table-row>text,.record>text,.record>view{min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.record view label{color:var(--text-3);overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.record-press{background:#eef5ff}
.empty{color:var(--text-3)}
.photo-item{background:#fff;border-color:var(--line);box-shadow:var(--shadow-sm)}
.photo-item label{color:var(--text-2)}
