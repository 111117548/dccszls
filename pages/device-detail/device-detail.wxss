m:1rpx solid rgba(65,177,210,.14);box-sizing:border-box}.table-head{color:#527b8c;background:rgba(19,59,77,.35);font-size:16rpx}.table-row{color:#bad4de;font-size:18rpx}.mono{color:#48d0ed;font:16rpx monospace}.severity-major{color:#ff5d71}.severity-moderate{color:#efba4b}.record{display:flex;flex-wrap:wrap;align-items:center;min-height:78rpx;padding:0 18rpx;border-bottom:1rpx solid rgba(65,177,210,.14);font-size:18rpx}.record>text:first-child{color:#45cce9;font:16rpx monospace}.record view text{display:block}.record view label{display:block;color:#587e8f;font-size:16rpx;margin-top:5rpx}.empty{padding:42rpx;text-align:center;color:#50798b}
