<view class="detail-page">
  <view class="asset-head"><view><text class="asset-code">INSTALLATION NODE // {{node.id}}</text><text class="asset-name">{{node.name}}</text><label>{{node.type}} · {{node.constructionStatusName || '安装施工质量节点'}}</label></view><view class="health"><text>{{node.qualityScore || node.healthScore}}</text><label>QUALITY</label></view><text class="state state-{{status}}">{{status === 'danger' ? '严重缺陷' : status === 'warning' ? '待整改' : '受控'}}</text></view>
  <view class="detail-grid">
    <view class="panel tree-panel"><view class="panel-title"><text>施工构件结构</text><label>CONSTRUCTION WBS</label></view><device-tree rows="{{childRows}}" selected-id="{{nodeId}}" bind:nodetap="onNodeTap" /></view>
    <view class="panel"><view class="panel-title"><text>安装质量状态</text><label>INSTALLATION QUALITY</label></view><view class="metrics"><view><text>{{records.length}}</text><label>报验/检查记录</label></view><view><text class="alarm">{{defects.length}}</text><label>累计安装缺陷</label></view><view><text>{{photos.length}}</text><label>质量见证照片</label></view></view><view class="industrial-btn" bindtap="startInspection" role="button">对该构件发起AI安装检查</view></view>
  </view>
  <view class="panel table-panel"><view class="panel-title"><text>缺陷台账</text><label>DEFECT REGISTER</label></view><view class="table-head"><text>编号</text><text>位置</text><text>缺陷</text><text>等级</text><text>状态</text></view><view class="table-row" wx:for="{{defects}}" wx:key="id" data-id="{{item.id}}" bindtap="openDefect" hover-class="record-press" role="button" aria-label="打开缺陷 {{item.name}}"><text class="mono">{{item.id}}</text><text>{{item.positionCode}}</text><text>{{item.name}}</text><text class="severity severity-{{item.severity}}">{{item.level}}</text><text>{{item.statusName}}</text></view><view class="empty" wx:if="{{!defects.length}}">当前设备暂无缺陷记录</view></view>
  <view class="panel"><view class="panel-title"><text>检查记录</text><label>INSPECTION RECORDS</label></view><view class="record" wx:for="{{records}}" wx:key="id"><text>{{item.id}}</text><view><text>{{item.name}}</text><label>{{item.inspector}} · {{item.time}}</label></view><text>{{item.photoCount}} 张</text><text>{{item.defectCount}} 缺陷</text></view><view class="empty" wx:if="{{!records.length}}">暂无关联检查记录</view></view>
  <view class="panel"><view class="panel-title"><text>历史照片</text><label>HISTORICAL PHOTOS</label></view><scroll-view scroll-x class="photo-strip"><view class="photo-item" wx:for="{{photos}}" wx:key="id"><image src="{{item.image}}" mode="aspectFill" alt="{{item.positionCode}} 的历史质量照片"></image><text>{{item.positionCode}}</text><label>{{item.name}}</label></view><view class="empty" wx:if="{{!photos.length}}">暂无可用历史照片；后续AI巡检照片会自动关联到此节点</view></scroll-view></view>
</view>
