<view class="model-page">
  <view class="page-command"><view><text>CONSTRUCTION QUALITY TWIN // {{project.drawingNo}}</text><label>{{project.name}} / {{project.deviceName}} / {{project.layout}}</label></view><text class="online">● 安装质量数据在线</text></view>
  <construction-twin-3d project-name="{{project.name}}" device-name="{{project.deviceName}}" stage-index="{{project.stageIndex}}" stage-name="{{project.stage}}" markers="{{markers}}" compact bind:parttap="onTwinPartTap" bind:markertap="onDefectTap" />
  <view class="workspace">
    <view class="tree-pane"><view class="pane-title"><text>CONSTRUCTION WBS</text><label>安装构件层级</label></view><device-tree rows="{{rows}}" selected-id="{{selectedId}}" bind:nodetap="onNodeTap" /></view>
    <view class="detail-pane">
      <view class="pane-title"><text>INSTALLATION STATUS</text><label>施工进度与质量状态</label></view>
      <view class="node-title"><view><text>{{selectedNode.name}}</text><label>ID // {{selectedNode.id}}</label></view><text class="state state-{{selectedNode.status}}">{{selectedNode.status === 'danger' ? '严重缺陷' : selectedNode.status === 'warning' ? '待整改' : '受控'}}</text></view>
      <view class="node-metrics"><view><text>{{selectedNode.qualityScore || selectedNode.healthScore}}</text><label>安装质量评分</label></view><view><text class="warn">{{selectedNode.defectCount}}</text><label>活动缺陷</label></view><view><text>{{selectedNode.constructionStatusName || '施工检查'}}</text><label>施工状态</label></view></view>
      <view class="defect-mini" wx:if="{{selectedDefects.length}}"><view wx:for="{{selectedDefects}}" wx:key="id" bindtap="openDefect" data-id="{{item.id}}" hover-class="record-press" role="button" aria-label="打开缺陷 {{item.name}}"><text class="alarm"></text><text>{{item.positionCode}} · {{item.name}}</text><label>{{item.statusName}}</label></view></view>
      <view class="empty" wx:else>当前节点无活动缺陷</view>
      <button class="industrial-btn" bindtap="openProgress">查看施工进度与发货</button>
    </view>
  </view>
</view>
