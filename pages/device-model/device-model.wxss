page{background:#040c15;color:#d8edf5}.model-page{padding:22rpx;min-height:100vh;box-sizing:border-box;background:radial-gradient(circle at 50% 0,rgba(24,105,136,.18),transparent 30%)}.page-command{display:flex;justify-content:space-between;align-items:center;height:88rpx}.page-command text{display:block;color:#4bd7f5;font:19rpx monospace;letter-spacing:2rpx}.page-command label{display:block;color:#cfe7ef;font-size:22rpx;margin-top:7rpx}.page-command .online{color:#32d398;font-size:16rpx}.workspace{display:flex;flex-wrap:wrap;gap:16rpx;margin-top:18rpx}.tree-pane,.detail-pane{min-width:0;background:rgba(6,23,35,.82);border:1rpx solid rgba(65,177,210,.3)}.pane-title{display:flex;justify-content:space-between;align-items:center;height:62rpx;padding:0 18rpx;border-bottom:1rpx solid rgba(65,177,210,.26)}.pane-title text{color:#48d1ef;font:18rpx monospace;letter-spacing:2rpx}.pane-title label{color:#668b9b;font-size:17rpx}.node-title{display:flex;align-items:center;justify-content:space-between;padding:24rpx;border-bottom:1rpx solid rgba(65,177,210,.18)}.node-title view text{display:block;color:#fff;font-size:28rpx}.node-title label{display:block;color:#537b8d;font:17rpx monospace;margin-top:6rpx}.state{padding:7rpx 14rpx;color:#34d39a;border:1rpx solid #2c9d77;font-size:17rpx}.state-danger{color:#ff5a70;border-color:#b83e52}.state-warning{color:#efbd4f;border-color:#a47e31}.node-metrics{display:flex;flex-wrap:wrap;border-bottom:1rpx solid rgba(65,177,210,.18)}.node-metrics view{padding:23rpx;text-align:center;border-right:1rpx solid rgba(65,177,210,.14)}.node-metrics text{display:block;color:#e9fbff;font:700 30rpx monospace}.node-metrics text.warn{color:#ff6577}.node-metrics label{display:block;color:#5f8394;font-size:16rpx;margin-top:7rpx}.defect-mini{padding:15rpx 20rpx}.defect-mini>view{display:flex;align-items:center;min-height:58rpx;border-bottom:1rpx solid rgba(65,177,210,.14);font-size:18rpx}.defect-mini .alarm{width:9rpx;height:9rpx;margin-right:10rpx;background:#ff4059}.defect-mini>view>text:nth-child(2){flex:1;color:#bdd5de}.defect-mini label{color:#ecb64b}.empty{padding:50rpx;text-align:center;color:#527a8c}.industrial-btn{margin:15rpx 20rpx 24rpx;height:68rpx;line-height:68rpx;border-radius:0;color:#04141e;background:#41d3f1;font-size:20rpx}

/* 方案C */
page{background:#14191c;color:#f4f7f8}.model-page{background:linear-gradient(180deg,#1b2225,#111618);padding:24rpx}.page-command{height:100rpx;border-bottom:2rpx solid #59656a}.page-command text{color:#ffc229;font-size:20rpx;font-weight:700}.page-command label{color:#fff;font-size:23rpx}.page-command .online{color:#68e378}.tree-pane,.detail-pane{background:#20272a;border:1rpx solid #68747a}.pane-title{height:70rpx;border-bottom-color:#596469}.pane-title text{color:#ffc229;font-size:19rpx;font-weight:700}.pane-title label{color:#c2cace;font-size:18rpx}.node-title{border-bottom-color:#505b60}.node-title label{color:#aeb8bc}.state{color:#68e378;border:2rpx solid #68e378;font-size:18rpx}.state-danger{color:#ff6258;border-color:#ff6258}.state-warning{color:#ffc229;border-color:#ffc229}.node-metrics{border-bottom-color:#505a5f}.node-metrics view{padding:28rpx;border-right-color:#4e585d}.node-metrics text{color:#fff;font-size:33rpx}.node-metrics text.warn{color:#ffc229}.node-metrics label{color:#b2bcc0;font-size:18rpx}.defect-mini>view{min-height:68rpx;border-bottom-color:#4b555a;font-size:20rpx}.defect-mini>view>text:nth-child(2){color:#edf1f2}.defect-mini label{color:#ffc229}.empty{color:#aeb8bc}.industrial-btn{height:76rpx;line-height:76rpx;color:#111619;background:#ffc229;font-size:22rpx;font-weight:700}
.model-page{padding:24rpx;background:linear-gradient(180deg,#171e21,#101517)}.page-command{min-height:112rpx;height:auto;padding:16rpx 0}.page-command>view{min-width:0}.page-command text{font-size:21rpx}.page-command label{font-size:24rpx;line-height:1.4}.page-command .online{display:none}
.workspace{display:flex;flex-direction:column;gap:24rpx;margin-top:24rpx}.tree-pane,.detail-pane{width:100%;background:var(--color-neutral-850);border:2rpx solid var(--border-default);border-radius:var(--radius-sm)}.pane-title{min-height:76rpx;height:auto;padding:14rpx 18rpx}.pane-title text{font-size:20rpx}.pane-title label{font-size:21rpx}.tree-pane{max-height:620rpx;overflow:auto}
.node-title{padding:24rpx}.node-title view text{font-size:31rpx}.state{font-size:21rpx}.node-metrics{display:flex}.node-metrics view{flex:1;min-width:0;padding:24rpx 8rpx}.node-metrics text{font-size:34rpx}.node-metrics label{font-size:20rpx;line-height:1.4}.defect-mini>view{min-height:88rpx;font-size:23rpx}.record-press{background:#2b3539}.industrial-btn{min-height:88rpx;height:auto;line-height:1.4;font-size:26rpx}

/* V5.2 reference visual alignment */
page{background:#020d18}.model-page{background:radial-gradient(circle at 50% 5%,rgba(45,149,255,.12),transparent 36%),linear-gradient(180deg,#010812,#020d18)}
.page-command text,.pane-title text{color:var(--blue)}.tree-pane,.detail-pane{background:rgba(7,24,39,.92);border-color:var(--line)}
.industrial-btn{color:#fff;background:linear-gradient(135deg,#1978dd,#1051af);border:1rpx solid var(--blue)}

.industrial-btn{
  display:flex;
  align-items:center;
  justify-content:center;
  min-height:88rpx;
  padding:0 20rpx;
  line-height:1.2;
  text-align:center;
  white-space:nowrap;
}
.node-metrics text.warn,.defect-mini label{color:var(--yellow)}
