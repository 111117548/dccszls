<view class="screen ledger-screen">
  <view class="brand-bar brand-bar-compact">
    <image class="brand-logo" src="/images/brand/zijin-longking-horizontal.png" mode="aspectFit" aria-label="紫金龙净"></image>
    <view class="brand-meta"><text>工程质量数字化平台</text><label>ENGINEERING QUALITY</label></view>
  </view>
  <view class="feature-guide-entry" bindtap="openFeatureGuide" hover-class="ux-press" role="button">
    <view class="feature-guide-icon">?</view><view class="feature-guide-copy"><text>质量检查台账使用说明</text><label>同步查看、分享整改、提交证据与复验闭环</label></view><text class="feature-guide-arrow">›</text>
  </view>
  <view class="ledger-overview-card">
    <view class="ledger-title-row">
      <view class="ledger-heading"><text class="ledger-kicker">整改概况</text><text class="ledger-title">整改闭环</text><label>缺陷整改与复验台账</label></view>
      <button class="feishu-sync" bindtap="syncFeishuTasks" loading="{{feishuSyncing}}"><text>↻</text><label>同步飞书</label></button>
    </view>
    <text class="feishu-sync-note" wx:if="{{feishuSyncText}}">{{feishuSyncText}}</text>
    <view class="ledger-stats"><view class="reminder-anchor"><view wx:if="{{rectificationStats.pending}}" class="reminder-dot stat-reminder"></view><label>待整改</label><text class="red">{{rectificationStats.pending}}</text></view><view class="reminder-anchor"><view wx:if="{{rectificationStats.review}}" class="reminder-dot stat-reminder"></view><label>待复验</label><text class="yellow">{{rectificationStats.review}}</text></view><view class="reminder-anchor"><view wx:if="{{rectificationStats.overdue}}" class="reminder-dot stat-reminder"></view><label>已逾期</label><text class="red">{{rectificationStats.overdue}}</text></view></view>
    <view class="ledger-tabs">
      <button class="{{rectificationView === 'ongoing' ? 'active' : ''}}" data-view="ongoing" bindtap="switchRectificationView">进行中</button>
      <button class="{{rectificationView === 'closed' ? 'active' : ''}}" data-view="closed" bindtap="switchRectificationView">已闭环台账</button>
    </view>
  </view>

  <block wx:if="{{rectificationView === 'ongoing'}}">
    <view class="closure-flow-card panel">
      <view class="closure-flow-heading"><text>整改闭环流程</text><label>任务从发现到复验通过，全过程留痕</label></view>
      <view class="closure-flow"><view><text>⌕</text><label>发现缺陷</label></view><text>→</text><view><text>⇧</text><label>整改提交</label></view><text>→</text><view class="yellow"><text>◇</text><label>复验</label></view><text>→</text><view class="green"><text>✓</text><label>闭环</label></view></view>
    </view>
  </block>

  <view class="ledger-search" wx:if="{{rectificationView === 'closed'}}"><text>⌕</text><input value="{{searchKeyword}}" bindinput="onSearchInput" placeholder="搜索缺陷名称或记录编号" /></view>
  <text class="section-title">{{rectificationView === 'ongoing' ? '整改任务' : '闭环记录'}}</text>
  <view class="ledger-empty" wx:if="{{!rectificationRows.length}}">{{rectificationView === 'ongoing' ? '当前没有进行中的整改任务' : '暂未形成闭环台账'}}</view>

  <view class="ledger-row" wx:for="{{rectificationRows}}" wx:key="id">
    <view wx:if="{{rectificationView === 'ongoing'}}" class="reminder-dot row-reminder"></view>
    <button class="row-main" data-orderid="{{item.id}}" bindtap="openRectification">
      <view class="row-copy">
        <text class="row-task-title">{{item.title}}</text>
        <label class="row-position" wx:if="{{item.positionLabel}}">{{item.positionLabel}}</label>
      </view>
      <view class="row-meta" wx:if="{{rectificationView === 'closed'}}">
        <text class="row-date" wx:if="{{rectificationView === 'closed'}}">{{item.shortDate}}</text>
        <text class="row-status status-{{item.status}}">{{item.statusName}}</text>
        <text class="row-arrow">›</text>
      </view>
      <text class="row-open-arrow" wx:if="{{rectificationView === 'ongoing'}}">›</text>
    </button>
    <view class="row-actions" wx:if="{{rectificationView === 'ongoing'}}">
      <view class="row-action-state">
        <label>当前状态</label>
        <text class="row-status status-{{item.status}}">{{item.statusName}}</text>
      </view>
      <button wx:if="{{item.status === 'review'}}" data-orderid="{{item.id}}" bindtap="openRectification">去复验</button>
      <button wx:else bindtap="openRectificationShare" data-orderid="{{item.id}}">{{item.status === 'rejected' ? '重新分享' : '分享整改'}}</button>
    </view>
  </view>
</view>
