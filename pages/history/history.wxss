/* 台账按钮统一采用内容居中；底部导航保持图标在上、文字在下。 */
.ledger-tabs button,.row-actions button,.feishu-sync{
  display:flex;
  align-items:center;
  justify-content:center;
  line-height:1.2;
  white-space:nowrap;
}
.ledger-tabs button{height:84rpx;min-height:84rpx}
.row-actions button{height:68rpx;min-height:68rpx;padding:0 16rpx;font-size:24rpx}
.ledger-subnav button{
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:4rpx;
  min-height:118rpx;
  padding:8rpx 12rpx;
  line-height:1.15;
}
.ledger-subnav text,.ledger-subnav label{margin:0;line-height:1.15}
.ledger-row{position:relative}.row-reminder{top:8rpx;right:8rpx}.ledger-subnav .subnav-reminder{top:13rpx;right:calc(50% - 70rpx)}

.row-main{
  justify-content:flex-start;
  white-space:normal;
}

/* V7 long-title and narrow-screen hardening */
.ledger-title-row{align-items:flex-start}
.ledger-title,.ledger-heading label{white-space:normal;line-height:1.3}
.feishu-sync{flex-basis:168rpx;min-width:0;padding:10rpx 14rpx;white-space:normal}
.row-main view text{max-width:none}
.row-status{line-height:1.3;white-space:normal}
.row-actions button{height:auto;min-height:68rpx;padding-top:10rpx;padding-bottom:10rpx;white-space:normal}
@media (max-width:360px){
  .ledger-title-row{padding-left:22rpx;padding-right:22rpx}
  .ledger-title{font-size:37rpx}
  .feishu-sync{flex-basis:146rpx;font-size:20rpx}
  .ledger-row{flex-wrap:wrap;margin-left:22rpx;margin-right:22rpx}
  .row-main{flex-basis:100%}
  .row-actions{width:100%;padding:0 16rpx 14rpx}
  .row-actions button{width:100%;max-width:none}
}

/* V8 ledger typography and narrow-screen card layout */
.history-context-bar{
  min-height:96rpx;
  padding-top:14rpx;
  padding-bottom:14rpx;
}
.history-context-copy{
  flex:1;
  min-width:0;
}
.history-context-copy text{
  display:-webkit-box;
  overflow:hidden;
  color:var(--text);
  font-size:25rpx;
  font-weight:600;
  line-height:1.4;
  -webkit-box-orient:vertical;
  -webkit-line-clamp:2;
}
.history-context-copy label{
  display:block;
  margin-top:5rpx;
  overflow:hidden;
  color:var(--text-3);
  font-size:20rpx;
  line-height:1.3;
  white-space:nowrap;
  text-overflow:ellipsis;
}
.ledger-title-row{
  align-items:center;
  padding-top:28rpx;
  padding-bottom:14rpx;
}
.ledger-title{
  font-size:36rpx;
  line-height:1.2;
}
.ledger-heading label{
  margin-top:7rpx;
  font-size:20rpx;
  line-height:1.35;
}
.feishu-sync{
  flex-basis:154rpx;
  min-height:60rpx;
  padding:8rpx 14rpx;
  border-radius:30rpx;
  font-size:21rpx;
}
.feishu-sync-note{
  padding:4rpx 30rpx 18rpx;
  font-size:19rpx;
  line-height:1.4;
  text-align:left;
  white-space:normal;
}
.ledger-tabs button{
  font-size:27rpx;
}
.ledger-row{
  display:block;
  overflow:hidden;
  margin-bottom:18rpx;
  border-radius:12rpx;
}
.row-main{
  width:100%;
  min-height:116rpx;
  padding:20rpx 18rpx;
}
.row-main>.row-copy{
  flex:1;
  min-width:0;
  padding-left:14rpx;
  border-left:5rpx solid var(--blue);
}
.row-main .row-copy text{
  display:-webkit-box;
  overflow:hidden;
  max-width:none;
  font-size:27rpx;
  font-weight:700;
  line-height:1.35;
  white-space:normal;
  text-overflow:ellipsis;
  -webkit-box-orient:vertical;
  -webkit-line-clamp:2;
}
.row-main .row-copy label{
  display:-webkit-box;
  overflow:hidden;
  margin-top:7rpx;
  color:var(--text-2);
  font-size:20rpx;
  line-height:1.35;
  white-space:normal;
  text-overflow:ellipsis;
  -webkit-box-orient:vertical;
  -webkit-line-clamp:2;
}
.row-meta{
  display:flex;
  flex:0 0 auto;
  max-width:218rpx;
  align-items:center;
  justify-content:flex-end;
  margin-left:16rpx;
  padding-left:0;
  border-left:0;
}
.row-date{
  flex:0 0 auto;
  margin:0 10rpx 0 0;
  font-size:19rpx;
}
.row-status{
  width:auto;
  max-width:160rpx;
  padding:6rpx 10rpx;
  border:1rpx solid currentColor;
  border-radius:6rpx;
  font-size:20rpx;
  line-height:1.25;
  text-align:center;
  white-space:normal;
}
.row-arrow{
  flex:0 0 auto;
  margin-left:8rpx;
  color:var(--blue);
  font-size:34rpx;
}
.row-actions{
  display:flex;
  justify-content:flex-end;
  padding:0 18rpx 18rpx;
  border-top:1rpx solid var(--line-soft);
}
.row-actions button{
  width:168rpx;
  max-width:none;
  min-height:64rpx;
  margin-top:16rpx;
  padding:0 18rpx;
  border-radius:8rpx;
  font-size:23rpx;
  white-space:nowrap;
}
.row-reminder{
  z-index:2;
  top:10rpx;
  right:10rpx;
}
.ledger-subnav{
  height:calc(112rpx + env(safe-area-inset-bottom));
  padding-bottom:env(safe-area-inset-bottom);
}
.ledger-subnav button{
  min-height:112rpx;
}

@media (max-width:360px){
  .ledger-title{font-size:34rpx}
  .feishu-sync{flex-basis:142rpx}
  .ledger-row{display:block}
  .row-main{flex-basis:auto;padding-right:14rpx;padding-left:14rpx}
  .row-meta{max-width:190rpx;margin-left:10rpx}
  .row-status{max-width:140rpx;font-size:19rpx}
  .row-actions{width:auto;padding-right:14rpx;padding-left:14rpx}
  .row-actions button{width:160rpx}
}

/* V9 整改任务卡片：长标题、状态和操作分层，窄屏不相互挤压。 */
.ledger-row{
  border-radius:14rpx;
}
.row-main{
  position:relative;
  display:block;
  min-height:0;
  padding:24rpx 56rpx 22rpx 22rpx;
}
.row-main>.row-copy{
  width:100%;
  padding-left:16rpx;
  border-left:5rpx solid var(--blue);
}
.row-main .row-task-title{
  display:-webkit-box;
  overflow:hidden;
  max-width:none;
  color:var(--text);
  font-size:29rpx;
  font-weight:700;
  line-height:1.42;
  letter-spacing:.2rpx;
  white-space:normal;
  text-overflow:ellipsis;
  word-break:break-all;
  -webkit-box-orient:vertical;
  -webkit-line-clamp:3;
}
.row-main .row-position{
  display:block;
  overflow:hidden;
  margin-top:8rpx;
  color:var(--text-3);
  font-size:21rpx;
  line-height:1.4;
  white-space:nowrap;
  text-overflow:ellipsis;
}
.row-open-arrow{
  position:absolute;
  top:50%;
  right:22rpx;
  color:var(--blue);
  font-size:38rpx;
  line-height:1;
  transform:translateY(-50%);
}
.row-actions{
  min-height:92rpx;
  align-items:center;
  justify-content:space-between;
  gap:20rpx;
  padding:14rpx 20rpx;
  background:#fbfdff;
  border-top:1rpx solid var(--line-soft);
}
.row-action-state{
  display:flex;
  flex:1;
  min-width:0;
  align-items:center;
  gap:12rpx;
}
.row-action-state label{
  flex:0 0 auto;
  color:var(--text-3);
  font-size:20rpx;
}
.row-action-state .row-status{
  flex:0 0 auto;
  width:auto;
  max-width:none;
  padding:6rpx 12rpx;
  font-size:21rpx;
  font-weight:600;
  line-height:1.25;
  white-space:nowrap;
}
.row-actions button{
  flex:0 0 auto;
  width:168rpx;
  min-height:64rpx;
  margin:0;
  border-radius:8rpx;
  font-size:23rpx;
}
.row-main>.row-meta{
  display:flex;
  width:100%;
  max-width:none;
  align-items:center;
  justify-content:flex-start;
  gap:12rpx;
  margin:16rpx 0 0;
  padding:14rpx 0 0 16rpx;
  border-top:1rpx solid var(--line-soft);
}
.row-main>.row-meta .row-date{
  margin:0;
}
.row-main>.row-meta .row-arrow{
  margin-left:auto;
}

@media (max-width:360px){
  .row-main{
    padding:22rpx 50rpx 20rpx 18rpx;
  }
  .row-main .row-task-title{
    font-size:27rpx;
  }
  .row-actions{
    width:auto;
    padding:13rpx 16rpx;
  }
  .row-action-state label{
    display:none;
  }
  .row-actions button{
    width:154rpx;
  }
}
