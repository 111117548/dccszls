.records-screen{padding:20rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));color:#172437;background:#f4f7fb}
.records-context-card,.records-progress-card,.records-list{overflow:hidden;border:1rpx solid #d8e2ee;border-radius:14rpx;background:#fff;box-shadow:0 6rpx 18rpx rgba(25,52,82,.05)}
.records-context-card{display:flex;min-height:104rpx;align-items:center;padding:18rpx 20rpx}
.records-context-icon{display:flex;flex:0 0 62rpx;width:62rpx;height:62rpx;align-items:center;justify-content:center;margin-right:16rpx;border:1rpx solid #bdd2ea;border-radius:9rpx;background:#f5f9fe}
.records-context-icon image{width:46rpx;height:46rpx}.records-context-copy{flex:1;min-width:0}.records-context-copy text,.records-context-copy label{display:block;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.records-context-copy text{font-size:28rpx;font-weight:700}.records-context-copy label{margin-top:6rpx;color:#5d6b7c;font-size:20rpx}.records-context-arrow{margin-left:14rpx;color:#0b4aa2;font-size:38rpx}
.records-progress-card{padding:26rpx}.records-overview-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx;padding-bottom:22rpx;border-bottom:1rpx solid #e8eef5}.records-overview-head>view{min-width:0}.records-overview-kicker,.records-overview-name,.records-overview-head label{display:block}.records-overview-kicker{color:var(--brand);font-size:20rpx;font-weight:600}.records-overview-name{margin-top:5rpx;overflow:hidden;font-size:30rpx;font-weight:700;white-space:nowrap;text-overflow:ellipsis}.records-overview-head label{margin-top:5rpx;color:var(--text-3);font-size:20rpx}.records-overview-head button{flex:none;min-height:62rpx;margin:0;padding:0 20rpx;color:var(--brand);font-size:21rpx;line-height:60rpx;border:1rpx solid #b7d0ef;border-radius:14rpx;background:var(--brand-soft)}.records-overview-head button::after{border:0}.records-progress-title{display:flex;align-items:flex-end;justify-content:space-between;margin-top:24rpx}.records-progress-title>text{font-size:27rpx}.records-progress-title>view{display:flex;align-items:baseline}.records-progress-title>view text{color:#0b4aa2;font-size:44rpx;font-weight:700;line-height:1}.records-progress-title>view label{margin-left:7rpx;color:#8793a2;font-size:26rpx}
.records-progress-bar{height:12rpx;margin-top:20rpx;overflow:hidden;border-radius:999rpx;background:#e4ebf3}.records-progress-bar view{height:100%;border-radius:999rpx;background:#0b4aa2}
.records-stats{display:grid;margin-top:22rpx;padding-top:20rpx;border-top:1rpx solid #e8eef5;grid-template-columns:repeat(3,minmax(0,1fr))}.records-stats>view{text-align:center;border-right:1rpx solid #e8eef5}.records-stats>view:last-child{border-right:0}.records-stats label,.records-stats text{display:block}.records-stats label{color:#5d6b7c;font-size:20rpx}.records-stats text{margin-top:7rpx;font-size:31rpx;font-weight:700}.records-stats .success{color:#16845b}.records-stats .danger{color:#d7393f}
.records-toolbar{display:flex;align-items:center;padding:16rpx;border-bottom:1rpx solid #e8eef5}.records-filters{display:grid;flex:1;grid-template-columns:repeat(3,minmax(0,1fr));gap:10rpx}.records-filters view{display:flex;min-height:62rpx;align-items:center;justify-content:center;border:1rpx solid #d6e0eb;border-radius:8rpx;background:#fff;color:#5d6b7c;font-size:21rpx}.records-filters .active{border-color:#0b4aa2;background:#0b4aa2;color:#fff;font-weight:700}
.records-list{margin-top:20rpx;padding:0}.record-row{position:relative;display:flex;min-height:120rpx;align-items:center;padding:18rpx;border-bottom:1rpx solid #e8eef5}.record-row:last-child{border-bottom:0}.record-row-active{background:#eef5ff}.record-reminder{top:10rpx;right:10rpx}
.record-icon{display:flex;flex:0 0 62rpx;width:62rpx;height:62rpx;align-items:center;justify-content:center;margin-right:16rpx}.record-icon image{width:54rpx;height:54rpx}.record-copy{flex:1;min-width:0}.record-copy text,.record-copy label{display:block;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.record-copy text{font-size:25rpx;font-weight:700}.record-copy label{margin-top:7rpx;color:#5d6b7c;font-size:19rpx}.record-action{display:flex;flex:0 0 auto;align-items:center;margin-left:12rpx}.record-state{padding:5rpx 9rpx;border:1rpx solid currentColor;border-radius:6rpx;font-size:18rpx;white-space:nowrap}.state-completed{color:#16845b}.state-draft{color:#0b4aa2}.state-empty{color:#6b7889}.state-issue{color:#d7393f;background:#fff4f4}.record-arrow{margin-left:9rpx;color:#0b4aa2;font-size:34rpx}
.records-empty{display:flex;min-height:300rpx;flex-direction:column;align-items:center;justify-content:center;color:#5d6b7c}.records-empty text{font-size:25rpx}.records-empty label{margin-top:7rpx;font-size:19rpx}
.records-card-primary{width:100%;min-height:78rpx;margin-top:24rpx;color:#fff;font-size:25rpx;font-weight:700;border:0;border-radius:14rpx;background:var(--brand)}.records-card-primary::after{border:0}
@media (max-width:360px){.records-screen{padding-right:18rpx;padding-left:18rpx}.record-row{padding-right:14rpx;padding-left:14rpx}.record-icon{margin-right:12rpx}.record-state{max-width:76rpx;overflow:hidden;text-overflow:ellipsis}.records-overview-head button{padding:0 14rpx}}

/* Ant-style records: summary cards, segmented filter and list. */
.records-screen{color:var(--text);background:var(--bg)}.records-context-card,.records-progress-card,.records-list{border-color:var(--line-soft);border-radius:24rpx;box-shadow:var(--shadow-sm)}
.records-context-icon{border:0;border-radius:16rpx;background:#e6f4ff}.records-context-arrow,.record-arrow{color:#bfbfbf}
.records-filters{padding:5rpx;border-radius:14rpx;background:#f0f0f0;gap:0}.records-filters view{border:0;border-radius:10rpx;background:transparent}.records-filters .active{color:#1677ff;background:#fff;box-shadow:0 2rpx 8rpx rgba(0,0,0,.06)}
.record-row-active{background:#f5faff}.record-state{border:0;border-radius:999rpx}.state-completed{background:#f6ffed}.state-draft{color:#1677ff;background:#e6f4ff}.state-empty{background:#fafafa}.records-card-primary{border-radius:16rpx;background:#1677ff;box-shadow:none}
