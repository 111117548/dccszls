.profile-screen{padding:24rpx 24rpx calc(36rpx + env(safe-area-inset-bottom));background:#f4f7fb}
.profile-screen>.shared-brand-bar{margin-top:-24rpx;margin-right:-24rpx;margin-left:-24rpx}
.profile-card{display:flex;min-height:170rpx;align-items:center;padding:26rpx;border:1rpx solid #d6e0eb;border-radius:14rpx;background:#fff;box-shadow:0 8rpx 24rpx rgba(23,50,78,.05)}
.profile-avatar{display:flex;flex:0 0 82rpx;width:82rpx;height:82rpx;align-items:center;justify-content:center;margin-right:20rpx;color:#fff;font-size:31rpx;font-weight:800;border-radius:50%;background:#0b4aa2}.profile-copy{flex:1;min-width:0}.profile-copy text,.profile-copy label{display:block;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.profile-copy text{font-size:30rpx;font-weight:800}.profile-copy>label{margin-top:3rpx;color:#5d6b7c;font-size:20rpx}.profile-copy .profile-project{margin-top:11rpx;color:#8793a2;font-size:18rpx}
.profile-group{margin-top:20rpx;padding:0 20rpx;border:1rpx solid #d6e0eb;border-radius:14rpx;background:#fff}.profile-group-title{display:block;padding:20rpx 4rpx 10rpx;font-size:24rpx;font-weight:800}
.profile-row{display:flex;min-height:98rpx;align-items:center;border-top:1rpx solid #e8eef5}.profile-row-press{background:#f4f8fd}.profile-icon{display:flex;flex:0 0 52rpx;width:52rpx;height:52rpx;align-items:center;justify-content:center;margin-right:14rpx;color:#0b4aa2;font-size:17rpx;font-weight:800;border:1rpx solid #b9cee6;border-radius:10rpx;background:#eef5ff}.profile-row>view{flex:1;min-width:0}.profile-row>view text,.profile-row>view label{display:block;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.profile-row>view text{font-size:23rpx;font-weight:700}.profile-row>view label{margin-top:3rpx;color:#8793a2;font-size:17rpx}.profile-arrow{flex:0 0 auto;margin-left:12rpx;color:#8793a2;font-size:32rpx}.profile-status{flex:0 0 auto;margin-left:10rpx;padding:4rpx 10rpx;font-size:17rpx;border-radius:999rpx}.profile-status.normal{color:#16845b;background:#eef8f3}.profile-status.warning{color:#a76800;background:#fff7e7}
