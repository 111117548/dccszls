<view class="screen profile-screen">
  <view class="shared-brand-bar"><image src="/images/brand/zijin-longking-horizontal.png" mode="aspectFit" aria-label="紫金龙净"></image><view><text>工程质量数字化平台</text><label>ENGINEERING QUALITY</label></view></view>
  <view class="profile-card">
    <view class="profile-avatar">{{identity.bound ? '飞' : '我'}}</view>
    <view class="profile-copy"><text>{{userName}}</text><label>{{roleName}}{{isAdmin ? ' · 管理员' : ''}}</label><label class="profile-project">当前项目：{{projectName}}</label></view>
  </view>

  <view class="profile-group">
    <text class="profile-group-title">账号与协同</text>
    <view class="profile-row" bindtap="goFeishu" hover-class="profile-row-press"><text class="profile-icon">飞</text><view><text>飞书账号与授权</text><label>{{identity.bound ? '已绑定，可同步项目和整改任务' : '未绑定，点击完成账号授权'}}</label></view><text class="profile-arrow">›</text></view>
    <view class="profile-row" bindtap="goReminder" hover-class="profile-row-press"><text class="profile-icon">铃</text><view><text>微信订阅消息</text><label>管理到货预警、整改周报和催办</label></view><text class="profile-arrow">›</text></view>
  </view>

  <view class="profile-group">
    <text class="profile-group-title">系统与集成</text>
    <view class="profile-row" bindtap="goApi" hover-class="profile-row-press"><text class="profile-icon">API</text><view><text>API接口管理</text><label>{{isAdmin ? '查看状态并管理接口配置' : '查看接口运行状态'}}</label></view><label class="profile-status {{apiStatusClass}}">{{apiStatusText}}</label><text class="profile-arrow">›</text></view>
    <view class="profile-row" bindtap="goLogs" hover-class="profile-row-press"><text class="profile-icon">志</text><view><text>同步与任务日志</text><label>查看报告、资料和同步结果</label></view><text class="profile-arrow">›</text></view>
    <view class="profile-row" bindtap="showPermissions" hover-class="profile-row-press"><text class="profile-icon">权</text><view><text>权限与角色</text><label>查看当前账号的数据权限</label></view><text class="profile-arrow">›</text></view>
  </view>

  <view class="profile-group">
    <text class="profile-group-title">通用设置</text>
    <view class="profile-row" bindtap="goProjects" hover-class="profile-row-press"><text class="profile-icon">项</text><view><text>项目管理</text><label>管理项目、机组和当前上下文</label></view><text class="profile-arrow">›</text></view>
    <view class="profile-row" bindtap="showAbout" hover-class="profile-row-press"><text class="profile-icon">i</text><view><text>关于小程序</text><label>版本信息与产品说明</label></view><text class="profile-arrow">›</text></view>
  </view>
</view>
