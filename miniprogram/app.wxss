page {
  --brand: #07c160;
  --ink: #171a1f;
  --muted: #7b818b;
  --line: #e8eaed;
  --surface: #ffffff;
  --canvas: #f3f4f6;
  background: var(--canvas);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
}

button::after {
  border: 0;
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 76rpx;
  height: 76rpx;
  border-radius: 16rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 14rpx rgba(20, 26, 34, 0.12);
}

.avatar-sun { background: linear-gradient(145deg, #ffb22e, #ff7a18); }
.avatar-blue { background: linear-gradient(145deg, #5d9cff, #5865d8); }
.avatar-plum { background: linear-gradient(145deg, #c984ac, #8f6397); }
.avatar-user { background: linear-gradient(145deg, #79c69d, #3d9f70); }
