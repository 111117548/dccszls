<view class="tree">
  <view
    wx:for="{{displayRows}}" wx:key="id"
    class="tree-row {{selectedId === item.id ? 'selected' : ''}} level-{{item.level}}"
    style="padding-left:{{item.indent + 18}}rpx"
    data-id="{{item.id}}" bindtap="onNodeTap" hover-class="tree-row-press"
    role="button" aria-label="打开构件 {{item.name}}，质量 {{item.qualityScore || item.healthScore}} 分"
  >
    <view class="tree-line"></view>
    <text class="tree-caret">{{item.hasChildren ? '▾' : '└'}}</text>
    <image class="node-icon" src="{{item.iconPath}}" mode="aspectFit" aria-label="{{item.name}}图标"></image>
    <view class="node-main"><text class="node-name">{{item.name}}</text><text class="node-meta">质量 {{item.qualityScore || item.healthScore}} / 100 · {{item.constructionStatusName || '施工检查'}}</text></view>
    <text class="node-defects" wx:if="{{item.defectCount > 0}}">{{item.defectCount}}</text>
    <text class="node-status status-{{item.status}}"></text>
  </view>
</view>
