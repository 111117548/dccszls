.health-board { display:flex;flex-wrap:wrap;  min-height:250rpx; background:rgba(6,25,39,.72); border:1rpx solid rgba(67,182,218,.3); }
.score-block { display:flex;align-items:center;padding:28rpx 20rpx;border-right:1rpx solid rgba(67,182,218,.22); }
.score-ring { flex:none;width:130rpx;height:130rpx;padding:8rpx;box-sizing:border-box;background:#102f3a;border:8rpx solid #33d49a;border-radius:50%;box-shadow:0 0 25rpx rgba(51,212,154,.18); }
.ring-inner { display:flex;align-items:baseline;justify-content:center;width:100%;height:100%;background:#081a28;border-radius:50%;padding-top:32rpx;box-sizing:border-box; }
.score { color:#fff;font:700 47rpx/1 monospace; }.unit{color:#5f8c9e;font:17rpx monospace}
.score-copy { margin-left:18rpx; }.eyebrow{display:block;color:#43d5f4;font:16rpx monospace;letter-spacing:1rpx}.score-title{display:block;color:#cce6ef;font-size:22rpx;margin-top:10rpx}.score-state{display:block;color:#34d49a;font-size:17rpx;margin-top:10rpx}
.metric-grid { display:flex;flex-wrap:wrap;gap:20rpx 24rpx;padding:30rpx 24rpx;box-sizing:border-box; }
.metric-head{display:flex;justify-content:space-between;color:#86a9b8;font-size:19rpx}.metric-value{color:#d9f8ff;font:700 23rpx monospace}.metric-track{height:5rpx;margin-top:12rpx;background:#17394a}.metric-fill{height:100%;background:linear-gradient(90deg,#1f9fcb,#46e4f4);box-shadow:0 0 8rpx rgba(70,228,244,.45)}
/* 方案C */
.health-board{background:#20272a;border-color:#657177}.score-block{border-color:#59656a}.score-ring{border-radius:0;border:5rpx solid #ffc229;background:#30383b;box-shadow:none}.ring-inner{border-radius:0;background:#171d20}.score{color:#ffc229}.unit{color:#b8c1c5}.eyebrow{color:#20c7c5}.score-title{color:#fff;font-size:24rpx}.score-state{color:#68e378;font-size:19rpx}.metric-grid{gap:22rpx}.metric-head{color:#d0d7da;font-size:20rpx}.metric-value{color:#fff;font-size:25rpx}.metric-track{height:7rpx;background:#394246}.metric-fill{background:#20c7c5;box-shadow:none}

/* V3.8 Flexbox 响应式仪表 */
.health-board{display:flex;flex-direction:column;min-height:0;background:var(--color-neutral-850);border:0}
.score-block{min-height:190rpx;padding:28rpx;border-right:0;border-bottom:1rpx solid var(--border-subtle)}
.score-ring{width:140rpx;height:140rpx;border-color:var(--color-primary)}.score{color:var(--color-primary);font-size:48rpx}.unit{color:var(--text-secondary)}
.eyebrow{color:var(--color-info);font-size:18rpx}.score-title{font-size:28rpx}.score-state{color:var(--color-success);font-size:21rpx}
.metric-grid{display:flex;flex-wrap:wrap;gap:0;padding:0}.metric{width:50%;min-height:108rpx;padding:22rpx;border-right:1rpx solid var(--border-subtle);border-bottom:1rpx solid var(--border-subtle);box-sizing:border-box}.metric-head{color:var(--text-secondary);font-size:22rpx}.metric-value{font-size:28rpx}.metric-track{height:8rpx;background:var(--color-neutral-700)}.metric-fill{background:var(--color-info)}
