<view class="health-board">
  <view class="score-block">
    <view class="score-ring"><view class="ring-inner"><text class="score">{{score}}</text><text class="unit">/100</text></view></view>
    <view class="score-copy"><text class="eyebrow">CONSTRUCTION QUALITY INDEX</text><text class="score-title">安装质量指数</text><text class="score-state">● 重点工序受控</text></view>
  </view>
  <view class="metric-grid">
    <view class="metric" wx:for="{{metrics}}" wx:key="key">
      <view class="metric-head"><text>{{item.name}}</text><text class="metric-value">{{item.score}}</text></view>
      <view class="metric-track"><view class="metric-fill" style="width:{{item.score}}%"></view></view>
    </view>
  </view>
</view>
