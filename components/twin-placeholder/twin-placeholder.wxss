.twin-slot{position:relative;height:760rpx;overflow:hidden;background:radial-gradient(circle at 50% 40%,rgba(25,92,119,.28),transparent 42%),linear-gradient(180deg,#071421,#020a12);border:2rpx solid #365563;box-sizing:border-box}.twin-slot.compact{height:520rpx}.slot-grid{position:absolute;left:-20%;right:-20%;bottom:-14%;height:58%;opacity:.36;background-image:linear-gradient(rgba(44,122,151,.26) 1rpx,transparent 1rpx),linear-gradient(90deg,rgba(44,122,151,.26) 1rpx,transparent 1rpx);background-size:54rpx 54rpx;transform:perspective(420rpx) rotateX(58deg);transform-origin:center bottom}.slot-frame{position:absolute;left:26rpx;right:26rpx;top:26rpx;bottom:80rpx;border:1rpx dashed rgba(95,166,192,.5)}.corner{position:absolute;width:48rpx;height:48rpx;border-color:#38c9ef}.corner-lt{left:-2rpx;top:-2rpx;border-left:4rpx solid #38c9ef;border-top:4rpx solid #38c9ef}.corner-rt{right:-2rpx;top:-2rpx;border-right:4rpx solid #38c9ef;border-top:4rpx solid #38c9ef}.corner-lb{left:-2rpx;bottom:-2rpx;border-left:4rpx solid #38c9ef;border-bottom:4rpx solid #38c9ef}.corner-rb{right:-2rpx;bottom:-2rpx;border-right:4rpx solid #38c9ef;border-bottom:4rpx solid #38c9ef}.slot-center{position:absolute;left:50%;top:42%;width:78%;transform:translate(-50%,-50%);text-align:center}.slot-code{display:block;color:#3dcff1;font:20rpx monospace;letter-spacing:4rpx}.slot-title{display:block;margin-top:22rpx;color:#eefaff;font-size:40rpx;font-weight:700;letter-spacing:2rpx}.slot-desc{display:block;margin-top:14rpx;color:#86a7b5;font-size:23rpx}.slot-status{display:inline-flex;align-items:center;margin-top:30rpx;padding:12rpx 20rpx;color:#ffc229;background:rgba(46,40,22,.78);border:1rpx solid #8c742c;font-size:21rpx}.status-dot{width:10rpx;height:10rpx;margin-right:10rpx;background:#ffc229;box-shadow:0 0 12rpx #ffc229}.slot-meta{position:absolute;left:22rpx;right:22rpx;bottom:20rpx;display:flex;background:rgba(3,15,24,.8);border:1rpx solid rgba(74,137,160,.34)}.slot-meta>view{flex:1;min-width:0;padding:16rpx;border-right:1rpx solid rgba(74,137,160,.3)}.slot-meta>view:last-child{border-right:0}.slot-meta label{display:block;color:#52798a;font-size:17rpx}.slot-meta text{display:block;overflow:hidden;margin-top:7rpx;color:#c8e0e9;font-size:20rpx;text-overflow:ellipsis;white-space:nowrap}.slot-footer{position:absolute;left:26rpx;right:26rpx;bottom:20rpx;display:flex;justify-content:space-between;color:#52798a;font:17rpx monospace}.slot-footer text:last-child{color:#ffc229}
