.inspection-row{display:flex;align-items:center;min-height:92rpx;padding:12rpx 18rpx;border-bottom:1rpx solid rgba(67,182,218,.17);background:rgba(7,27,42,.46);box-sizing:border-box}.inspection-index{width:44rpx;height:44rpx;line-height:44rpx;text-align:center;color:#53daf6;border:1rpx solid #287895;font:19rpx monospace}.inspection-main{flex:1;min-width:0;margin-left:16rpx}.inspection-name{display:block;color:#d3e7ee;font-size:21rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.inspection-meta{display:block;color:#618798;font-size:17rpx;margin-top:7rpx}.inspection-data{width:66rpx;text-align:center}.inspection-data text{display:block;color:#e6fbff;font:700 24rpx monospace}.inspection-data label{display:block;color:#557a8c;font-size:15rpx}.inspection-data .defect-value{color:#ffbd4a}.inspection-state{width:66rpx;padding:6rpx 4rpx;text-align:center;color:#2fd49a;border:1rpx solid rgba(47,212,154,.45);font-size:16rpx}.state-in_progress{color:#49d6f2;border-color:rgba(73,214,242,.45)}

