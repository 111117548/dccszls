.twin-3d{position:relative;width:100%;height:100%;min-height:520rpx;overflow:hidden;background:radial-gradient(circle at 52% 46%,rgba(24,116,184,.15),transparent 46%),#010b14}
.twin-3d.compact{height:560rpx}
.floor-grid{position:absolute;z-index:0;left:-20%;right:-20%;bottom:-22%;height:55%;pointer-events:none;background-image:linear-gradient(rgba(36,105,160,.16) 1rpx,transparent 1rpx),linear-gradient(90deg,rgba(36,105,160,.16) 1rpx,transparent 1rpx);background-size:52rpx 52rpx;transform:perspective(420rpx) rotateX(58deg);transform-origin:center bottom}
.twin-canvas{position:absolute;z-index:1;left:0;right:0;top:0;bottom:0;width:100%;height:100%}
.loading,.fallback{position:absolute;z-index:3;left:0;right:0;top:0;bottom:0;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#2d95ff;background:rgba(1,11,20,.76)}
.state-title{margin-top:18rpx;color:#d9efff;font-size:24rpx;font-weight:700}
.state-subtitle{max-width:76%;margin-top:10rpx;color:#738fa5;font-size:19rpx;text-align:center}
.loading-cube{width:48rpx;height:48rpx;border:2rpx solid #2d95ff;box-shadow:inset 0 0 18rpx rgba(45,149,255,.35),0 0 20rpx rgba(45,149,255,.22);transform:rotate(45deg)}
.retry-button{min-height:58rpx;margin-top:24rpx;padding:0 28rpx;color:#2d95ff;line-height:58rpx;background:rgba(3,25,42,.9);border:1rpx solid #2d95ff;border-radius:0;font-size:20rpx}
.model-badge{position:absolute;z-index:4;left:20rpx;top:18rpx;display:flex;flex-direction:column;padding:9rpx 14rpx;background:rgba(3,17,29,.7);border-left:3rpx solid #2d95ff}
.model-stage-name{color:#d9efff;font-size:19rpx;font-weight:700}
.model-source{margin-top:3rpx;color:#69869c;font-size:15rpx}
.reset-view{position:absolute;z-index:4;right:20rpx;top:18rpx;min-height:56rpx;padding:0 18rpx;color:#8bbce2;line-height:56rpx;background:rgba(3,17,29,.72);border:1rpx solid rgba(72,137,184,.5);border-radius:0;font-size:19rpx}
.selection{position:absolute;z-index:4;left:50%;bottom:28rpx;padding:8rpx 14rpx;color:#42d780;background:rgba(6,38,29,.82);border:1rpx solid #2e9760;font-size:19rpx;transform:translateX(-50%)}
.defect-count{position:absolute;z-index:4;left:20rpx;bottom:22rpx;display:flex;align-items:center;padding:8rpx 12rpx;color:#ff817b;background:rgba(48,14,18,.82);border:1rpx solid #a83a3e;font-size:18rpx}
.defect-dot{width:9rpx;height:9rpx;margin-right:8rpx;background:#ff4d47}
.spatial-marker{position:absolute;z-index:5;width:46rpx;height:46rpx;min-height:0;margin:-23rpx 0 0 -23rpx;padding:0;color:#fff;line-height:42rpx;background:#ff4059;border:3rpx solid #ffc3c8;border-radius:50%;box-shadow:0 0 18rpx rgba(255,64,89,.9);font:700 24rpx monospace}

.twin-3d.light{background:radial-gradient(circle at 50% 42%,#fff 0,#f8fafc 56%,#edf2f7 100%)}
.twin-3d.light .floor-grid{bottom:-27%;height:49%;opacity:.7;background-image:linear-gradient(rgba(92,117,142,.11) 1rpx,transparent 1rpx),linear-gradient(90deg,rgba(92,117,142,.11) 1rpx,transparent 1rpx)}
.twin-3d.light .loading,.twin-3d.light .fallback{color:#0b4aa2;background:rgba(248,251,254,.94)}
.twin-3d.light .state-title{color:#25384d}
.twin-3d.light .state-subtitle{color:#748395}
.twin-3d.light .loading-cube{border-color:#0b4aa2;box-shadow:inset 0 0 18rpx rgba(11,74,162,.16),0 0 20rpx rgba(11,74,162,.12)}
.twin-3d.light .retry-button{color:#0b4aa2;background:#fff;border-color:#0b4aa2;border-radius:8rpx}
.twin-3d.light .model-badge{background:rgba(255,255,255,.88);border-left-color:#0b4aa2;box-shadow:0 6rpx 16rpx rgba(35,59,82,.08)}
.twin-3d.light .model-stage-name{color:#25384d}
.twin-3d.light .model-source{color:#7b8897}
.twin-3d.light .model-source{display:none}
.twin-3d.light .reset-view{color:#0b4aa2;background:rgba(255,255,255,.92);border-color:#aec5df;border-radius:8rpx;box-shadow:0 6rpx 16rpx rgba(35,59,82,.07)}
.twin-3d.light .selection{color:#126f4c;background:rgba(238,248,243,.94);border-color:#71b396;border-radius:6rpx}

.retry-button,.reset-view,.spatial-marker{
  display:flex;
  align-items:center;
  justify-content:center;
  line-height:1.2;
  text-align:center;
  white-space:nowrap;
}
