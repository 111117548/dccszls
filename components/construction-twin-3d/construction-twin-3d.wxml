<view class="twin-3d {{compact ? 'compact' : ''}} {{minimal ? 'minimal' : ''}} {{light ? 'light' : ''}}">
  <view class="floor-grid"></view>
  <canvas type="webgl" id="constructionTwinCanvas" class="twin-canvas {{assembling ? 'assembly-active' : ''}}" bindtouchstart="touchStart" bindtouchmove="touchMove" bindtouchend="touchEnd"></canvas>

  <view class="loading" wx:if="{{loading && !fallback}}">
    <view class="loading-cube"></view>
    <text class="state-title">正在装载工程模型</text>
    <label class="state-subtitle">双室电除尘器 · GLB 2.0</label>
  </view>

  <view class="fallback" wx:if="{{fallback}}">
    <text class="state-title">3D 模型暂时无法显示</text>
    <label class="state-subtitle">{{modelError}}</label>
    <button class="retry-button" bindtap="retryModel">重新加载</button>
  </view>

  <view class="model-badge" wx:if="{{ready && !minimal}}">
    <text class="model-stage-name">S{{stageIndex}} · {{stageLabel}}</text>
    <label class="model-source">{{modelCaption}}</label>
  </view>
  <view class="assembly-status" wx:if="{{ready && assembling}}">
    <view class="assembly-status-head"><text>施工顺序回放</text><label>{{assemblyStepText}}</label></view>
    <view class="assembly-stage-name">{{assemblyStageLabel}}</view>
    <view class="assembly-track"><view style="width:{{assemblyProgress}}%"></view></view>
    <label class="assembly-hint">部件从顶部落位 · 触摸模型可跳过</label>
  </view>
  <button class="spatial-marker" wx:for="{{markers}}" wx:key="id" style="left:{{item.markerX}}%;top:{{item.markerY}}%;" data-index="{{index}}" catchtap="markerTap" aria-label="查看缺陷 {{item.defectType || item.name}}">!</button>
  <button class="reset-view" wx:if="{{ready && !assembling}}" bindtap="resetView">复位</button>
  <view class="selection" wx:if="{{selectedPart && !minimal}}">{{selectedPart}} 已选中</view>
  <view class="defect-count" wx:if="{{markers.length}}"><view class="defect-dot"></view>{{markers.length}} 个模型缺陷标记待处理</view>
</view>
